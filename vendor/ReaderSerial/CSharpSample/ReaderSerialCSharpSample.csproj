<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P10-2: PRD SS18-3 ("C# 프로그램에서 P/Invoke 방식으로 DLL API와 CALLBACK을
    사용할 수 있다")를 재현하는 최소 WinForms 예제.

    PlatformTarget을 반드시 x86으로 고정한다 - ReaderSerial.dll은 Win32(x86)
    빌드이므로, 이 프로젝트가 AnyCPU/x64로 빌드되면 프로세스 비트수가
    맞지 않아 DllImport 시점에 BadImageFormatException으로 로드가 실패한다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>ReaderSerialCSharpSample</RootNamespace>
    <AssemblyName>ReaderSerialCSharpSample</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    ReaderSerial.dll(Win32/x86 C++ 빌드 산출물)은 이 프로젝트의 참조 대상이
    아니라 런타임에 DllImport로 로드되는 네이티브 DLL이므로 일반적인 프로젝트
    참조/ProjectReference로는 출력 폴더에 자동으로 복사되지 않는다. ReaderSerial
    프로젝트가 같은 $(Configuration)으로 bin\Win32\$(Configuration)\에 이미
    빌드되어 있다면 그 DLL을 이 프로젝트의 출력 폴더로 복사해, 빌드 직후
    바로 실행 가능하게 한다. 아직 그쪽이 빌드되지 않았다면 조용히 건너뛴다 —
    이 프로젝트 자체의 빌드 성공 여부와는 무관해야 한다(예제 프로젝트이므로
    ReaderSerial 빌드를 강제 의존시키지 않음).
  -->
  <Target Name="CopyReaderSerialDll" AfterTargets="Build">
    <PropertyGroup>
      <ReaderSerialDllSource>$(MSBuildProjectDirectory)\..\..\bin\Win32\$(Configuration)\ReaderSerial.dll</ReaderSerialDllSource>
    </PropertyGroup>
    <Copy
      SourceFiles="$(ReaderSerialDllSource)"
      DestinationFolder="$(OutDir)"
      Condition="Exists('$(ReaderSerialDllSource)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
