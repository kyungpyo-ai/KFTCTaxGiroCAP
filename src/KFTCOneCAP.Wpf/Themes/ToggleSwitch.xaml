<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        CModernToggleSwitch 대응: 좌측 라벨 텍스트 + 우측 토글 노브.
        IsChecked 상태에 따라 노브가 좌우로 슬라이드하는 애니메이션 포함.
        (완전한 IsPending 스피너 상태는 이번 Phase 필수 아님 — 여기서는 간단한 회전 스피너로 근사)

        2026-08-13 수정 (사용자 피드백: "OFF를 해도 파란색이 유지됨"):
        트랙 색을 IsChecked 단순 Trigger + hover MultiTrigger 두 군데에서 각각 별도의
        ColorAnimation Storyboard로 건드리고 있었는데, 두 애니메이션이 동시에 같은 속성
        ((Border.Background).(SolidColorBrush.Color))을 잡고 있다가 우선순위가 꼬여서 OFF로
        돌아가는 애니메이션이 켜짐 상태의 애니메이션에 덮여버리는 문제였다. 색상은 (Setter 기반,
        즉시 전환)으로 바꾸고 트리거 선언 순서로만 우선순위를 제어해 충돌을 없앴다. 노브 슬라이드는
        IsChecked 하나만 건드리는 속성이라 애니메이션을 유지해도 안전하다.

        2026-08-13 추가 (최신 UI 트렌드 점검): 버튼/콤보박스에는 눌림 피드백이 있는데 토글만
        없어서 일관성이 떨어졌다 — 노브가 눌렀을 때 살짝 오므라들었다(scale 0.82) 놓으면
        탄성 있게(BackEase) 원래 크기로 돌아오는 IsPressed 트리거를 추가했다.

        2026-08-13 추가 수정 (사용자 발견 버그): "텍스트박스 포커스 표시가 다른 창을 클릭하면
        없어지는데 토글을 클릭하면 안 없어진다" — 원인은 Focusable="False"였다. 포커스를 받을 수
        없는 컨트롤을 클릭해도 키보드 포커스가 실제로 옮겨가지 않아서, 이전에 포커스를 갖고 있던
        텍스트박스의 파란 보더가 그대로 남아있었다. Focusable="True" + FocusVisualStyle="{x:Null}"
        (기본 점선 포커스 사각형만 제거)로 바꿔서, 클릭 시 포커스가 정상적으로 토글로 넘어가
        텍스트박스 쪽 포커스 표시가 제대로 해제되게 했다.
    -->

    <!-- 원본 CModernToggleSwitch::DrawItem 트랙 색상(hover 시 더 진해짐) -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#E6ECF5"/>
    <SolidColorBrush x:Key="ToggleOffHoverBrush" Color="#D0DAE8"/>
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#0064DD"/>
    <SolidColorBrush x:Key="ToggleOnHoverBrush" Color="#1476F5"/>
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="White"/>

    <Style x:Key="ModernToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="18.67"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Content}"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>

                        <Border x:Name="Track"
                                Grid.Column="2"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="{StaticResource ToggleOffBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Knob"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{StaticResource ToggleKnobBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="3,0,0,0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="KnobTransform" X="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="3" ShadowDepth="1"/>
                                    </Border.Effect>
                                </Border>

                                <!-- IsPending 상태용 간이 스피너(작은 회전 링). 기본은 숨김 -->
                                <Border x:Name="Spinner"
                                        Width="14" Height="14"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="2"
                                        BorderBrush="{StaticResource Blue500Brush}"
                                        CornerRadius="7"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 노브 슬라이드만 애니메이션 (IsChecked 하나만 건드리는 단독 속성이라 안전) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                          Storyboard.TargetProperty="X"
                                                          To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                          Storyboard.TargetProperty="X"
                                                          To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--
                            트랙 색상은 전부 즉시 전환 Setter로만 제어한다(애니메이션 충돌 방지).
                            선언 순서 = 우선순위: 아래로 갈수록 더 구체적인 조건이 이긴다.
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOffHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOnBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOnHoverBrush}"/>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>

                        <!-- 눌림(press) 피드백: 노브가 살짝 오므라들었다 놓으면 복원(토스/카카오류 탄성감) -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
