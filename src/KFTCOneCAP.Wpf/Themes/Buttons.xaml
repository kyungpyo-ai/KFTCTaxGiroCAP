<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:KFTCOneCAP.Wpf.Controls">

    <!--
        CModernButton(원본 ModernUI.h) 대응 Button 스타일.
        PRD 2.3 표 기준 최소 변형: Auto(회색 텍스트 버튼, 홈 하단 최소화/종료) /
        Default(홈 헤더 로그전송 버튼 계열, 연한 배경 호버) / Primary(강조 파란 버튼) /
        Reader(리더기 설정 화면의 콤보 옆 액션 버튼, 흰 배경 + 얇은 보더).
    -->

    <!--
        공통 베이스: 라운드 보더 + 호버/눌림 트랜지션.
        2026-08-13 수정: "클릭 효과가 부족함" 피드백 반영 — 토스/카카오/네이버류 최신 UI 트렌드에
        맞춰 눌렀을 때 살짝 축소(scale 0.97)되는 탄성 있는 클릭 피드백을 모든 버튼 변형 공통으로 추가.

        2026-08-13 추가 수정: ToggleSwitch.xaml과 동일한 이유로 Focusable="False"를 "True"로
        변경(+FocusVisualStyle="{x:Null}"로 기본 점선 사각형만 제거) — 버튼이 포커스를 받을 수
        없으면 클릭해도 이전에 포커스를 갖고 있던 텍스트박스/콤보박스의 포커스 표시가 안 풀린다.
    -->
    <Style x:Key="ModernButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        2026-08-13 수정(사용자 피드백: "테두리 유/무, 버튼 위치 등등 개선해줘"):
        docs/home_reader_setup/screenshots/home_screen.png 실측 결과 헤더 로그전송/업데이트 버튼과 하단
        최소화/종료 버튼은 모두 평상시 테두리·배경이 전혀 보이지 않는 "고스트" 버튼이다
        (원본 ModernUI.cpp CModernButton::DrawItem 확인: isLogTransfer/isUpdate 분기는 호버 시에만
        배경을 채우고 테두리를 아예 그리지 않으며, isExit 분기도 평상시 배경색을 부모 배경(kHomeBg)과
        동일하게 설정해 테두리가 사실상 보이지 않는다). 아래 3개 스타일 모두 BorderThickness=0으로
        덮어써 평상시 테두리를 완전히 제거한다.
    -->

    <!-- Auto: 홈 하단 최소화/종료 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 회색 배경 -->
    <Style x:Key="AutoButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource MinimizeExitTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MinimizeExitHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MinimizeExitHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D8DCE0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default: 홈 헤더 "로그 전송" 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 파란 배경 -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LogSendHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource LogSendHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CDE4FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Update: 홈 헤더 "최신 버전 업데이트" 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 초록 배경(PRD 3.5) -->
    <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource UpdateHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UpdateHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CFF5CF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: 강조 파란 버튼(예: 업데이트, 확인) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0052B8"/>
                <Setter Property="BorderBrush" Value="#0052B8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#00449A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ReaderSecondary: 리더기 설정 화면 "취소" 버튼 전용(흰 배경 + 얇은 회색 보더 + 검정 텍스트).
        2026-08-14 추가(사용자 피드백 대응 과정에서 확인): 아래 ReaderButtonStyle을 연한 파랑
        "활성" 톤으로 바꾸면서 기존에 취소 버튼이 공유하던 흰 배경+보더 모양이 같이 사라졌는데,
        docs/home_reader_setup/screenshots/reader_setup.png 실측 결과 "취소" 버튼은 액션 버튼과 다른 중립 톤
        (흰 배경+회색 보더)이 맞으므로 별도 스타일로 분리.
    -->
    <Style x:Key="ReaderSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource TblBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5F7FA"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#EAEDF1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Reader: 리더기 설정 화면 콤보 옆 액션 버튼(초기화/상태체크/키다운로드/무결성체크/업데이트)
        및 "조회" 버튼.

        2026-08-14 재작업(사용자 피드백: "액션 버튼/조회 버튼 색상이 원본과 다름"): 기존에는
        흰 배경+회색 보더 고정 스타일(호버 시에만 옅은 파랑)이었으나, docs/home_reader_setup/screenshots/
        reader_setup.png 실측 결과 실제로는 두 가지 "상시" 시각 상태가 있다 —
        (1) 포트가 활성(COM 포트 지정)인 리더기 카드: 연한 파란 배경(#DCEBFF)+파란 텍스트가
            hover 여부와 무관하게 항상 표시(테두리 없음)
        (2) 포트가 "미사용"인 리더기 카드: 연한 회색 배경+회색 텍스트(테두리 없음)
        원본 CModernButton은 버튼 자체의 "활성/비활성" 색상 팔레트가 IsEnabled에 매핑되므로,
        여기서는 base(ModernButtonBase)가 IsEnabled=False일 때 전체를 반투명(Opacity 0.5)
        처리하던 동작을 이 스타일에서는 쓰지 않고, 대신 Template을 완전히 새로 작성해
        IsEnabled 트리거로 배경/텍스트 색상 자체를 바꾼다(불투명도 유지, PRD 4.7 "콤보/토글/
        나머지 버튼 비활성화"와 자연스럽게 연결 — Views/ReaderSetupWindow.xaml.cs의 콤보
        SelectionChanged 핸들러가 이 카드 버튼들의 IsEnabled를 토글한다).
        "조회" 버튼도 PRD/스크린샷 재확인 결과 "확인" 전용 진한 파랑(PrimaryButtonStyle)이
        아니라 이 스타일(연한 파랑)을 쓴다.

        2026-08-14 추가(Phase 5 보완, 사용자 피드백: "로딩 상태에 텍스트만 바뀌고 스피너가 없다"):
        ContentPresenter 단독이던 콘텐츠 영역을 가로 StackPanel(스피너+ContentPresenter)로 재구성.
        스피너는 controls:ButtonLoadingHelper.IsLoading 첨부 속성(Views/ReaderSetupWindow.xaml.cs가
        버튼 클릭 시 True/False로 토글)이 True일 때만 보이며, 점선(StrokeDashArray) 원을
        RotateTransform + 무한 반복 Storyboard로 돌려 회전이 눈에 보이도록 했다(균일한 색의
        완전한 링은 대칭이라 회전해도 시각적으로 정지해 보이므로, ToggleSwitch.xaml의 기존
        스피너 패턴 대신 대시 패턴을 사용— 실제로 회전이 보이는 형태로 새로 설계).
    -->
    <Style x:Key="ReaderButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="#DCEBFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="Spinner"
                                     Width="12" Height="12"
                                     Margin="0,0,6,0"
                                     StrokeThickness="2"
                                     Stroke="{TemplateBinding Foreground}"
                                     StrokeDashArray="2,1.4"
                                     Visibility="Collapsed"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CDE4FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 비활성(포트 "미사용" 카드) — 연한 회색 배경 + 회색 텍스트, 반투명 처리 안 함 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F3F5"/>
                            <Setter Property="Foreground" Value="#9AA5B1"/>
                        </Trigger>
                        <!-- 로딩 스피너: controls:ButtonLoadingHelper.IsLoading=True 인 동안만 표시 + 무한 회전 -->
                        <Trigger Property="controls:ButtonLoadingHelper.IsLoading" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinnerSpinBeginStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinnerSpinBeginStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Info: 리더기 설정 화면의 "?" info 버튼(원본 CInfoIconButton 대응, PRD 2.3/4.10).
        docs/home_reader_setup/screenshots/reader_setup.png 실측 결과 "i"가 아니라 물음표(?) 글리프이며, 평상시
        연한 블루 원형 배경 + 진한 블루 텍스트, 호버 시 배경이 살짝 진해지는 형태.
    -->
    <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Width" Value="{StaticResource ReaderInfoButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource ReaderInfoButtonSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="Content" Value="?"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        HomeCard: 홈 화면 카드(리더기 설정/가맹점 설정/결제/전표 설정) 버튼.
        Phase 3(ROADMAP.md/PRD 3.4): 호버(리프트+미세확대+글로우)/눌림(축소+배경보간+테두리 페이드)
        애니메이션 추가.

        구현 메모:
        - Bd(테두리)의 Background/BorderBrush는 TemplateBinding이 아니라 템플릿 내부에서 직접 만든
          "로컬" SolidColorBrush(BdBg/BdBorder)를 사용한다. TemplateBinding으로 Button.Background에
          연결하면 결국 리소스 딕셔너리의 공유(frozen) Brush 인스턴스를 애니메이션 타겟으로 잡게 되어
          런타임 예외(Freezable이 이미 freeze됨) 위험이 있고, 설령 freeze되지 않았더라도 카드 4개가
          같은 Brush 인스턴스를 공유해 한 카드만 눌러도 전체 카드 색이 바뀌는 버그가 난다. 템플릿은
          카드(Button)마다 별도 인스턴스로 생성되므로 로컬 Brush도 카드별로 독립적이다.
        - 리프트/축소는 TranslateTransform(Y) + ScaleTransform 조합, 글로우는 DropShadowEffect의
          Opacity를 0→비활성/hover 시 올림.
        - 아이콘 배경/글리프 색 반전(호버 아님, 눌림 시에만 — PRD 3.4)은 카드 콘텐츠(Border/Path)에
          별도로 적용하는 HomeCardIconBoxStyle/HomeCardIconGlyphStyle 참고(아래).
    -->
    <Style x:Key="HomeCardButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            BorderThickness="1"
                            CornerRadius="{StaticResource HomeCardCornerRadius}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBg" Color="{StaticResource CardBgColor}"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="BdBorder" Color="{StaticResource CardBorderColor}"/>
                        </Border.BorderBrush>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CardTranslate" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow" Color="#1F3B5C" Opacity="0"
                                               BlurRadius="24" ShadowDepth="8" Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            호버: 글로우만(리프트도 확대도 없음).
                            2026-08-14 변경(사용자 지시): 기존엔 5px 위로 뜨는 리프트(TranslateTransform
                            Y)도 있었으나, 모달(리더기 설정 등)을 한 번이라도 연 카드에서만 그 카드의
                            리프트가 다시 발동하지 않는 렌더링/컴포지션 버그(docs/home_reader_setup/ROADMAP.md "알려진
                            이슈" 참고, 여러 방식으로 시도했으나 원인 미해결)가 있어 리프트 자체를
                            없앴다. 리프트를 뺀 뒤로는 이 버그의 발동 조건(리프트 트랜스폼 재생)이
                            사라지므로 증상도 함께 사라진다.

                            2026-08-18 추가 변경(사용자 피드백: "저해상도에서 호버 시 글자가
                            꿀렁거리고, 일반 해상도에서도 호버 반응이 느려 렉 걸린 것처럼 보임"):
                            남아있던 미세 확대(1.005) 애니메이션이 매 프레임 Border 하위 트리(텍스트
                            포함)를 벡터로 다시 래스터라이즈해 ClearType 서브픽셀 위치가 흔들리고,
                            그 재계산 비용 때문에 반응도 둔해 보이는 원인이었다. CacheMode=
                            "BitmapCache"로 비트맵을 캐싱해 GPU로만 확대하는 방식도 시도했으나,
                            캐시된 비트맵을 실제로 확대하는 순간(RenderAtScale을 아무리 올려도) 항상
                            약간의 리샘플링 흐림이 남았고, 캐싱 자체가 평상시(호버 전) 렌더링에도
                            영향을 줘 대기 상태에서도 살짝 흐려 보이는 새 문제가 생겼다(원인: 캐시된
                            비트맵이 픽셀 그리드에 완벽히 정렬되지 않아 합성 시 미세한 리샘플링이
                            항상 발생). 1.005배는 육안으로 거의 인지되지 않는 수준의 효과라, 리프트를
                            없앴을 때와 같은 판단으로 확대 자체를 제거하고 글로우(그림자)만 남긴다 —
                            이러면 텍스트가 전혀 다시 그려지지 않아(스케일 트랜스폼이 걸리지 않음)
                            흔들림/흐림/반응 지연이 근본적으로 발생할 수 없다.
                        -->
                        <!--
                            호버: 빠르고 즉각적인 글로우 피드백(0.08초 트랜지션).
                            지연감(렉 느낌)을 없애기 위해 0.22초에서 0.08초로 대폭 단축하고
                            테두리 색상(CardBorderHoverColor) 보간을 함께 적용해 즉각적인 반응성 확보.
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                          To="0.30" Duration="0:0:0.08"/>
                                        <ColorAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardBorderHoverColor}" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.08"/>
                                        <ColorAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardBorderColor}" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 눌림: 6px 아래로 밀림 + 축소(0.96) + 배경 CardFillPressed 보간 + 테두리 페이드아웃 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="6" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="0.96" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="0.96" Duration="0:0:0.09"/>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardFillPressedColor}" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.09"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="1" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardBgColor}" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        카드 아이콘 배경 Border / 글리프 Path 색 반전 (눌림 시에만, PRD 3.4:
        "아이콘 배경은 진한 블루로, 아이콘 글리프는 흰색에 가깝게 반전").
        각 카드의 Border/Path에 개별 Fill/Background를 주지 않고 이 스타일을 적용하면
        RelativeSource로 상위 Button(카드)의 IsPressed를 참조해 동일 효과를 낸다.
    -->
    <Style x:Key="HomeCardIconBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardIconBgBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}" Value="True">
                <Setter Property="Background" Value="{StaticResource Blue500Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeCardIconGlyphStyle" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource Blue500Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}" Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
