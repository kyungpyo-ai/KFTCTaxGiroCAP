<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        CModernButton(원본 ModernUI.h) 대응 Button 스타일.
        PRD 2.3 표 기준 최소 변형: Auto(회색 텍스트 버튼, 홈 하단 최소화/종료) /
        Default(홈 헤더 로그전송 버튼 계열, 연한 배경 호버) / Primary(강조 파란 버튼) /
        Reader(리더기 설정 화면의 콤보 옆 액션 버튼, 흰 배경 + 얇은 보더).
    -->

    <!--
        공통 베이스: 라운드 보더 + 호버/눌림 트랜지션.
        2026-08-13 수정: "클릭 효과가 부족함" 피드백 반영 — 토스/카카오/네이버류 최신 UI 트렌드에
        맞춰 눌렀을 때 살짝 축소(scale 0.97)되는 탄성 있는 클릭 피드백을 모든 버튼 변형 공통으로 추가.

        2026-08-13 추가 수정: ToggleSwitch.xaml과 동일한 이유로 Focusable="False"를 "True"로
        변경(+FocusVisualStyle="{x:Null}"로 기본 점선 사각형만 제거) — 버튼이 포커스를 받을 수
        없으면 클릭해도 이전에 포커스를 갖고 있던 텍스트박스/콤보박스의 포커스 표시가 안 풀린다.
    -->
    <Style x:Key="ModernButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        2026-08-13 수정(사용자 피드백: "테두리 유/무, 버튼 위치 등등 개선해줘"):
        docs/screenshots/home_screen.png 실측 결과 헤더 로그전송/업데이트 버튼과 하단
        최소화/종료 버튼은 모두 평상시 테두리·배경이 전혀 보이지 않는 "고스트" 버튼이다
        (원본 ModernUI.cpp CModernButton::DrawItem 확인: isLogTransfer/isUpdate 분기는 호버 시에만
        배경을 채우고 테두리를 아예 그리지 않으며, isExit 분기도 평상시 배경색을 부모 배경(kHomeBg)과
        동일하게 설정해 테두리가 사실상 보이지 않는다). 아래 3개 스타일 모두 BorderThickness=0으로
        덮어써 평상시 테두리를 완전히 제거한다.
    -->

    <!-- Auto: 홈 하단 최소화/종료 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 회색 배경 -->
    <Style x:Key="AutoButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource MinimizeExitTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MinimizeExitHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MinimizeExitHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D8DCE0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default: 홈 헤더 "로그 전송" 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 파란 배경 -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LogSendHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource LogSendHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CDE4FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Update: 홈 헤더 "최신 버전 업데이트" 버튼. 평상시 테두리/배경 없음, 호버 시에만 옅은 초록 배경(PRD 3.5) -->
    <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource UpdateHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UpdateHoverTextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#CFF5CF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: 강조 파란 버튼(예: 업데이트, 확인) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0052B8"/>
                <Setter Property="BorderBrush" Value="#0052B8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#00449A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Reader: 리더기 설정 화면 콤보 옆 액션 버튼(초기화/상태체크/키다운로드/무결성체크/업데이트) -->
    <Style x:Key="ReaderButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource TblBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EFF6FF"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blue500Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue500Brush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#DCEBFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        HomeCard: 홈 화면 카드(리더기 설정/가맹점 설정/결제/전표 설정) 버튼.
        Phase 3(ROADMAP.md/PRD 3.4): 호버(리프트+미세확대+글로우)/눌림(축소+배경보간+테두리 페이드)
        애니메이션 추가.

        구현 메모:
        - Bd(테두리)의 Background/BorderBrush는 TemplateBinding이 아니라 템플릿 내부에서 직접 만든
          "로컬" SolidColorBrush(BdBg/BdBorder)를 사용한다. TemplateBinding으로 Button.Background에
          연결하면 결국 리소스 딕셔너리의 공유(frozen) Brush 인스턴스를 애니메이션 타겟으로 잡게 되어
          런타임 예외(Freezable이 이미 freeze됨) 위험이 있고, 설령 freeze되지 않았더라도 카드 4개가
          같은 Brush 인스턴스를 공유해 한 카드만 눌러도 전체 카드 색이 바뀌는 버그가 난다. 템플릿은
          카드(Button)마다 별도 인스턴스로 생성되므로 로컬 Brush도 카드별로 독립적이다.
        - 리프트/축소는 TranslateTransform(Y) + ScaleTransform 조합, 글로우는 DropShadowEffect의
          Opacity를 0→비활성/hover 시 올림.
        - 아이콘 배경/글리프 색 반전(호버 아님, 눌림 시에만 — PRD 3.4)은 카드 콘텐츠(Border/Path)에
          별도로 적용하는 HomeCardIconBoxStyle/HomeCardIconGlyphStyle 참고(아래).
    -->
    <Style x:Key="HomeCardButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            BorderThickness="1"
                            CornerRadius="{StaticResource HomeCardCornerRadius}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBg" Color="{StaticResource CardBgColor}"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="BdBorder" Color="{StaticResource CardBorderColor}"/>
                        </Border.BorderBrush>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CardTranslate" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow" Color="#1F3B5C" Opacity="0"
                                               BlurRadius="24" ShadowDepth="8" Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 호버: 5px 리프트 + 미세 확대(1.005) + 글로우, back-ease-out 근사 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="-5" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="1.005" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="1.005" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                          To="0.35" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 눌림: 6px 아래로 밀림 + 축소(0.96) + 배경 CardFillPressed 보간 + 테두리 페이드아웃 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="6" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="0.96" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="0.96" Duration="0:0:0.09"/>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardFillPressedColor}" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.09"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                                                          To="-5" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                          To="1.005" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                          To="1.005" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="BdBg" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource CardBgColor}" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="BdBorder" Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        카드 아이콘 배경 Border / 글리프 Path 색 반전 (눌림 시에만, PRD 3.4:
        "아이콘 배경은 진한 블루로, 아이콘 글리프는 흰색에 가깝게 반전").
        각 카드의 Border/Path에 개별 Fill/Background를 주지 않고 이 스타일을 적용하면
        RelativeSource로 상위 Button(카드)의 IsPressed를 참조해 동일 효과를 낸다.
    -->
    <Style x:Key="HomeCardIconBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardIconBgBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}" Value="True">
                <Setter Property="Background" Value="{StaticResource Blue500Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeCardIconGlyphStyle" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource Blue500Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}" Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
