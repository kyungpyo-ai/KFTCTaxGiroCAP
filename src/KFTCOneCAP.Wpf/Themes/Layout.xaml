<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        홈 화면(및 향후 리더기 설정 화면) 레이아웃 치수 — "일반" 모드(96dpi 기준, PRD 3.3).
        Phase 8에서 컴팩트 모드(세로 해상도 ≤800px) 대응 시 이 파일과 동일한 키 셋을 가진
        Themes/Layout.Compact.xaml을 추가하고 런타임에 ResourceDictionary를 스왑하는 방식으로
        전환한다(docs/ROADMAP.md Phase 2/8 참고). 그러므로 홈/리더기설정 XAML에서는 치수를
        리터럴로 적지 말고 항상 이 파일의 키를 참조할 것.

        수치 출처: docs/PRD_WPF.md 3.3장 + docs/screenshots/home_screen.png 실측 대조.
        (참고: 원본 스크린샷은 카드 높이 등 일부 값이 PRD 리터럴과 픽셀 단위로 정확히 일치함이
        확인되어, 스크린샷과 PRD 수치가 실질적으로 같은 소스를 가리키는 것으로 판단하고 PRD
        수치를 그대로 채택함.)
    -->

    <!-- 창 크기 (고정, ResizeMode=NoResize) -->
    <sys:Double x:Key="HomeWindowWidth">1104</sys:Double>
    <sys:Double x:Key="HomeWindowHeight">567</sys:Double>

    <!-- 좌우 여백 / 헤더 상단 여백 -->
    <sys:Double x:Key="HomeMarginX">50</sys:Double>
    <sys:Double x:Key="HomeHeaderTop">38</sys:Double>

    <!-- 헤더 로고 -->
    <sys:Double x:Key="HomeLogoBoxSize">54</sys:Double>

    <!-- 카드 영역 -->
    <sys:Double x:Key="HomeCardGap">18</sys:Double>
    <sys:Double x:Key="HomeCardVisualH">260</sys:Double>
    <CornerRadius x:Key="HomeCardCornerRadius">20</CornerRadius>

    <!--
        GridLength 버전 — RowDefinition.Height / ColumnDefinition.Width 는 double 이 아니라
        GridLength 타입이라 위 sys:Double 리소스를 그대로 바인딩하면 XamlParseException 발생.
        값은 항상 위 HomeCardGap/HomeCardVisualH 와 동일하게 유지할 것.
    -->
    <GridLength x:Key="HomeCardGapGridLength">18</GridLength>
    <GridLength x:Key="HomeCardVisualHGridLength">260</GridLength>

    <!-- 카드 아이콘 -->
    <sys:Double x:Key="HomeCardIconBoxSize">56</sys:Double>
    <sys:Double x:Key="HomeCardIconInset">28</sys:Double>
    <CornerRadius x:Key="HomeCardIconCornerRadius">12</CornerRadius>

    <!--
        2026-08-13 추가 수정(사용자 피드백): 카드 내부 아이콘-제목 사이 간격.
        기존에는 아이콘과 제목 사이 행에 "*"(가변) GridLength를 사용해 카드 높이가 고정(260)인
        상황에서 제목/설명 텍스트가 카드 하단으로 밀려 내려가는 문제가 있었다(실측 결과 아이콘
        하단과 제목 상단 간격이 88px까지 벌어짐). docs/screenshots/home_screen.png 실측(아이콘
        하단 y=259, 제목 상단 y=283 → 간격 24px) 기준으로 고정 간격으로 교체.
    -->
    <GridLength x:Key="HomeCardIconTitleGapGridLength">24</GridLength>

    <!-- 헤더 버튼 (로그 전송 / 최신 버전 업데이트) -->
    <sys:Double x:Key="HomeHeaderLogSendBtnW">132</sys:Double>
    <sys:Double x:Key="HomeHeaderLogSendBtnH">36</sys:Double>
    <sys:Double x:Key="HomeHeaderUpdateBtnW">205</sys:Double>
    <sys:Double x:Key="HomeHeaderUpdateBtnH">36</sys:Double>

    <!-- 하단 버튼 (최소화 / 종료) -->
    <sys:Double x:Key="HomeFooterBtnW">184</sys:Double>
    <sys:Double x:Key="HomeFooterBtnH">40</sys:Double>
    <sys:Double x:Key="HomeFooterBtnGap">16</sys:Double>

    <!--
        복합 Margin(Thickness) 리소스 — XAML 속성 하나에 여러 {StaticResource}를 섞어 쓸 수 없어
        (마크업 확장은 속성 값 전체를 단일 확장으로 파싱) 위 개별 치수를 조합한 Thickness를
        별도 키로 둔다. 값의 출처는 항상 위 개별 리소스와 동일(HomeMarginX/HomeHeaderTop).
    -->
    <Thickness x:Key="HomeHeaderMargin">50,38,50,0</Thickness>
    <Thickness x:Key="HomeCardsAreaMargin">50,0,50,0</Thickness>
    <Thickness x:Key="HomeDividerMargin">50,0,50,0</Thickness>
    <Thickness x:Key="HomeFooterBtnMargin">16,0,0,0</Thickness>

    <!-- 카드 내부 콘텐츠 패딩: 좌상단은 HomeCardIconInset(28)과 동일한 값을 사용 -->
    <Thickness x:Key="HomeCardContentMargin">28,28,20,24</Thickness>

    <!--
        ===================== 리더기 설정 화면 (Phase 4, docs/ROADMAP.md / PRD 4장) =====================
        원본은 "최초 1회 레이아웃 계산 후 창 크기 확정"(PRD 4.2) 방식. Phase 4~5에서는 이를
        Window.SizeToContent="WidthAndHeight" + 아래 컴포넌트별 고정 치수(PRD 4.3~4.6 수치)로
        자연스럽게 크기가 결정되도록 구성했었다.

        2026-08-14 변경(사용자 피드백: "리더기 설정창이 켜질때 자체의 오버헤드를 줄일수있는방법은
        없어?"): SizeToContent는 창을 보일 때마다 "내용에 맞춰 크기 계산"하는 추가 레이아웃
        패스를 매번 태우는데, 아래 컴포넌트 치수들이 전부 고정값이라 결과 창 크기도 항상 동일하게
        나온다 — 그래서 그 계산 결과값을 아래 ReaderWindowWidth/Height로 한 번 고정해두고
        Views/ReaderSetupWindow.xaml에서 SizeToContent 대신 이 리소스 키를 직접 참조하도록
        바꿨다(PRD 4.2 "최초 1회 레이아웃 계산 후 창 크기 확정"의 취지 그대로 — 매번이 아니라
        "최초 1회"만 계산해서 고정). 리터럴이 아니라 리소스 키로 두었으므로, 나중에 Phase 7
        컴팩트 모드에서 이 파일과 동일한 키 셋을 가진 컴팩트 전용 Layout 딕셔너리로 스왑하면
        창 크기도 자동으로 같이 바뀐다 — 컴팩트 모드 계획과 충돌하지 않음.
        값 출처: 기존 SizeToContent 결과를 96dpi 환경에서 GetWindowRect로 실측(744×820, 타이틀바/
        테두리 포함 전체 창 크기 — WPF Window.Width/Height와 동일 기준).
    -->

    <!-- 창 크기 (고정, ResizeMode=NoResize) -->
    <sys:Double x:Key="ReaderWindowWidth">744</sys:Double>
    <sys:Double x:Key="ReaderWindowHeight">820</sys:Double>

    <!--
        2026-08-14 수정(사용자 피드백: "창이 세로로 너무 길고 글자가 큼"): 아래 리더기 설정
        전용 치수들을 docs/screenshots/reader_setup.png 픽셀 실측(전체 캡처 776x883 중 다이얼로그
        자체가 약 762x875, 세로/가로 비율 ≈1.15) 대비 직전 구현(772x1005, 비율 ≈1.30)이 약 13%
        더 세로로 길었던 것을 보정하기 위해 각 섹션의 상하 패딩/마진 위주로 축소함(가로 폭은
        원본과 이미 거의 일치했으므로 유지). 아래 각 항목의 새 값은 실행 캡처 재대조로 확정.
    -->

    <!-- 메인 카드(다이얼로그 전체를 감싸는 흰색 라운드 카드) -->
    <CornerRadius x:Key="ReaderMainCardCornerRadius">16</CornerRadius>
    <Thickness x:Key="ReaderMainCardPadding">28,20,28,20</Thickness>

    <!-- 헤더 아이콘(홈 화면 리더기 카드 아이콘과 동일 글리프를 공유, 배경만 진한 블루로 고정) -->
    <sys:Double x:Key="ReaderHeaderIconBoxSize">46</sys:Double>
    <CornerRadius x:Key="ReaderHeaderIconCornerRadius">12</CornerRadius>

    <!-- 섹션 제목 좌측 블루 바("▍포트 설정" 등) -->
    <sys:Double x:Key="ReaderSectionBarWidth">4</sys:Double>
    <sys:Double x:Key="ReaderSectionBarHeight">14</sys:Double>

    <!-- 서브 카드(포트 설정 / 무결성 체크 정보), 배경 (ReaderSubCardBgBrush #FAFBFD) -->
    <CornerRadius x:Key="ReaderSubCardCornerRadius">16</CornerRadius>
    <Thickness x:Key="ReaderSubCardPadding">18,12,18,12</Thickness>

    <!-- 리더기 카드(1/2 공통) — PRD 4.3 기준값(128/12)에서 세로 축소 보정 적용 -->
    <sys:Double x:Key="ReaderCardMinHeight">112</sys:Double>
    <sys:Double x:Key="ReaderCardGap">8</sys:Double>
    <!-- Margin 속성에 직접 넣기 위한 Thickness 버전(ReaderCardGap과 동일 값 유지) -->
    <Thickness x:Key="ReaderCardGapMargin">0,8,0,0</Thickness>
    <Thickness x:Key="ReaderCardPadding">14,10,14,10</Thickness>

    <!-- 좌측 번호 뱃지 — PRD 4.4 기준값(34, radius 6)에서 축소 보정 -->
    <sys:Double x:Key="ReaderBadgeSize">30</sys:Double>
    <CornerRadius x:Key="ReaderBadgeCornerRadius">5</CornerRadius>

    <!-- COM 포트 콤보 — PRD 4.3/4.4: 178/152(일반/컴팩트), 폭은 원본과 이미 일치해 유지 -->
    <sys:Double x:Key="ReaderComboWidth">178</sys:Double>

    <!-- 액션 버튼(초기화/상태체크/키다운로드/무결성체크/업데이트) — 폭은 PRD 100 유지, 높이만 축소 -->
    <sys:Double x:Key="ReaderActionButtonWidth">100</sys:Double>
    <sys:Double x:Key="ReaderActionButtonHeight">32</sys:Double>
    <sys:Double x:Key="ReaderActionButtonGap">8</sys:Double>

    <!-- info 버튼(CInfoIconButton 대응) — PRD 2.3: 18~22px 원형, 축소 보정 -->
    <sys:Double x:Key="ReaderInfoButtonSize">18</sys:Double>

    <!--
        "포트 열기" 토글 자리 — Phase 4에서는 토글 자체를 만들지 않고(작업 지시 명시,
        Phase 6에서 배선) 리더기2 카드와 좌우 위치를 맞추기 위한 빈 공간(Visibility=Hidden)만
        확보한다. 폭은 스크린샷 실측(라벨 "포트 열기" + 토글 44 + info 20 + 내부 간격)에 근사한 값.
    -->
    <sys:Double x:Key="ReaderPortOpenPlaceholderWidth">148</sys:Double>

    <!--
        토글-info 버튼 사이 간격 / 토글 그룹 사이 간격 / 액션버튼 사이 간격 / 하단버튼 사이 간격.
        Margin 속성에는 {StaticResource}와 리터럴 콤마를 함께 쓸 수 없어(마크업 확장은 속성값
        전체를 단일 확장으로 파싱, Layout.xaml 상단 HomeHeaderMargin 주석과 동일 사유) Thickness
        완제품 리소스로 별도 제공한다.
    -->
    <Thickness x:Key="ReaderToggleInfoGapMargin">6,0,0,0</Thickness>
    <Thickness x:Key="ReaderToggleGroupGapMargin">24,0,0,0</Thickness>
    <Thickness x:Key="ReaderActionButtonGapMargin">8,0,0,0</Thickness>
    <Thickness x:Key="ReaderBottomBtnGapMargin">16,0,0,0</Thickness>

    <!-- 무결성 체크 정보: 조회기간 콤보 / 조회 버튼 -->
    <sys:Double x:Key="ReaderQueryComboWidth">110</sys:Double>
    <sys:Double x:Key="ReaderQueryButtonWidth">72</sys:Double>
    <sys:Double x:Key="ReaderQueryButtonHeight">32</sys:Double>

    <!-- 무결성 체크 리스트 — PRD 4.3/4.6 기준값(166/36)에서 세로 축소 보정, 가시 3행 고정 유지 -->
    <sys:Double x:Key="ReaderListHeight">142</sys:Double>
    <sys:Double x:Key="ReaderListHeaderHeight">32</sys:Double>
    <!-- GridLength 버전(RowDefinition.Height 바인딩용, HomeCardVisualHGridLength와 동일 사유) -->
    <GridLength x:Key="ReaderListHeightGridLength">142</GridLength>
    <GridLength x:Key="ReaderListHeaderHeightGridLength">32</GridLength>

    <!-- 하단 확인/취소 버튼 — PRD 4.3 기준값(110x36)에서 높이 축소 보정, 간격은 기존 패턴(16) 유지 -->
    <sys:Double x:Key="ReaderBottomBtnW">110</sys:Double>
    <sys:Double x:Key="ReaderBottomBtnH">32</sys:Double>
    <sys:Double x:Key="ReaderBottomBtnGap">16</sys:Double>

</ResourceDictionary>
