<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        CSkinnedEdit 대응. 홈/리더기 설정 화면에는 없지만(가맹점 설정 화면에서 사용),
        디자인 시스템 일관성을 위해 미리 정의해둔다.
        ComboBox.xaml과 동일한 KFTCInputTheme(borderN/borderH/borderF, radius 6px)을 그대로 재사용한다:
        normal=GRAY_200(1px) / hover=GRAY_300(2px) / focus=BLUE_500(1.6px).
        원본 CSkinnedEdit::DrawItem에는 SetValidationError(bError) API가 있으나 실제 페인트 코드에서
        border 색을 바꾸는 분기가 없어(추적만 하고 시각적으로 반영되지 않는 상태) 여기서도 시각 효과를
        임의로 만들어 넣지 않는다 — 필요해지면 그때 원본 최신 동작을 다시 확인하고 추가한다.

        2026-08-13 수정 (사용자 피드백: "텍스트 크기가 텍스트 입력창보다 커서 잘려보임"):
        실측 결과 진짜 원인은 컨테이너 높이 부족이었다 — ComboBox의 선택항목 표시는 단순
        ContentPresenter라 텍스트의 실제 잉크 높이만큼만 차지하지만, TextBox는 캐럿 이동/줄바꿈을
        위해 항상 폰트의 "전체 줄높이"(ascent+descent, Pretendard는 이 여백이 큰 편)를 예약한다.
        기존 Height=36 + Padding 6(위아래)는 FontSize 18.67px 기준 필요한 줄높이보다 작아서,
        Border의 CornerRadius로 인한 자동 클리핑에 걸려 글자 위쪽이 잘려 보였다(Height=80으로
        키워서 전체가 보이는 것으로 원인 확정, 44px에서 여유있게 들어맞는 것 확인).
        MinHeight=44를 기본값으로 둬서 향후 사용처가 실수로 더 작은 Height를 지정해도 최소
        여유는 항상 확보되게 했다. VerticalContentAlignment는 TemplateBinding으로 정상 연결
        해뒀다(WPF 권장 패턴 — 높이가 충분할 때 수직 중앙 정렬이 정확히 동작하려면 필요).

        2026-08-13 추가 수정: hover에서 보더 두께까지 같이 바뀌니 클릭한 것처럼 보인다는 피드백
        반영 — hover는 색상만 바꾸고(두께는 계속 1px), 두께 변화(1.6px, 파란색)는 실제 클릭/포커스
        상태(IsFocused)에만 남겨서 hover와 클릭 상태가 시각적으로 명확히 구분되게 했다.

        2026-08-13 추가 수정: "hover 효과가 너무 연함" 피드백 — ComboBox.xaml과 동일하게 hover
        보더를 더 진한 회색(ComboBoxHoverBorderBrush, #9CA3AF)으로 바꿨다. (배경 틴트도 같이
        넣었었으나, 입력 컨테이너는 hover에서 배경까지 칠하면 비활성화 상태처럼 보일 수 있어
        트렌드에 맞지 않는다는 피드백에 따라 제거 — 보더 색만으로 처리)

        2026-08-13 추가 수정 (레이아웃 흔들림 버그, 사용자가 직접 발견): IsFocused에서
        BorderThickness를 1→1.6px로 바꾸던 게 컨트롤의 실제 렌더링 크기를 키웠는데, 이 TextBox는
        고정 Height 없이 MinHeight=44만 쓰고 있어서(콤보박스는 사용처에서 Height를 고정해서 안
        보였던 것과 달리) 포커스를 줄 때마다 필요한 전체 높이가 44px를 넘어서면서 아래 요소가
        진짜로 밀려 내려갔다. 두께를 1.5px로 **고정**하고 상태별로 색상만 바꾸는 방식으로 전환해
        (ComboBox.xaml과 동일 패턴) 레이아웃이 절대 흔들리지 않게 했다.
    -->

    <Style x:Key="SkinnedTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PretendardMediumFontFamily}"/>
        <Setter Property="FontSize" Value="18.67"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TitleTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Blue500Brush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ComboBoxHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ComboBoxFocusBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource SkinnedTextBoxStyle}"/>

</ResourceDictionary>
