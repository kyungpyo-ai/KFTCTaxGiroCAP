<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        폰트 우선순위(PRD 2.2): Pretendard → 실패 시 Malgun Gothic.
        임베딩된 Pretendard-Regular.ttf / Pretendard-Bold.ttf 는 내부 family 이름이 "Pretendard" 로 동일하며
        FontWeight(Normal/Bold)로 스타일이 구분된다. Pretendard-Medium.ttf 는 내부 family 이름이
        "Pretendard Medium" 으로 별도이므로 전용 FontFamily 리소스를 둔다.

        ExtraBold(800) 웨이트 폰트 파일이 원본 fonts 폴더에 없어(Regular/Medium/Bold만 존재),
        PRD가 요구하는 홈 타이틀 ExtraBold는 Bold(700)로 폴백한다. (docs/ROADMAP.md Phase 1 참고)

        PRD 2.2 표의 폰트 크기는 pt 단위(원본 MFC LOGFONT 포인트 크기)이다. WPF FontSize는 1/96인치 단위(px)이므로
        96dpi 기준 pt→px 변환(× 96/72 ≈ 1.333)을 적용해 시각적 크기를 맞춘다.
    -->
    <FontFamily x:Key="PretendardFontFamily">pack://application:,,,/Assets/Fonts/#Pretendard, Malgun Gothic</FontFamily>
    <FontFamily x:Key="PretendardMediumFontFamily">pack://application:,,,/Assets/Fonts/#Pretendard Medium, Malgun Gothic</FontFamily>

    <!-- ===================== 홈 화면 ===================== -->

    <!-- 타이틀 "KFTCOneCAP" : 19pt / ExtraBold(800) 요구 → Bold(700)로 폴백 -->
    <Style x:Key="HomeTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="25.33"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <!-- 서브타이틀 : 13pt / Regular -->
    <Style x:Key="HomeSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="17.33"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
    </Style>

    <!-- 카드 제목 : 15pt / Bold -->
    <Style x:Key="HomeCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}"/>
    </Style>

    <!-- 카드 설명 : 11pt / Regular -->
    <Style x:Key="HomeCardDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="14.67"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 하단 버튼(최소화/종료/로그전송/업데이트) : 12pt / Regular -->
    <Style x:Key="HomeFooterButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <!-- ===================== 리더기 설정 화면 ===================== -->
    <!--
        2026-08-14 수정(사용자 피드백: "글자가 커 보인다"): docs/screenshots/reader_setup.png
        실측 대조 결과 PRD 표의 pt→px 기계적 환산값(× 96/72)이 실제 화면보다 눈에 띄게 크게
        렌더링되어, 아래 크기들을 스크린샷 재대조로 축소 보정함(창 세로 길이 보정과 함께
        Layout.xaml 패딩/마진 축소와 동시에 적용 — 자세한 배경은 Layout.xaml 상단 주석 참고).
    -->

    <!-- 헤더 타이틀 -->
    <Style x:Key="ReaderHeaderTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <!--
        헤더 서브타이틀
        2026-08-14 수정(가독성 개선): docs/screenshots/reader_setup.png 실측 결과 서브타이틀은
        타이틀(Bold)과 뚜렷이 대비되는 가는 굵기(Regular)로 렌더링되어 있음을 확인 — 기존 Bold는
        타이틀과 위계 구분이 안 되는 원인이었다. 최신 UI 트렌드(제목=굵게, 설명=가늘게+연한 색)에도
        부합하므로 Normal로 변경.
    -->
    <Style x:Key="ReaderHeaderSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="13.33"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
    </Style>

    <!-- 섹션 제목 : 진한 검정(#191F28) 대신 세련된 차콜(#333D4B) + Medium/Bold 조합 -->
    <Style x:Key="ReaderSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="15.33"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}"/>
    </Style>

    <!-- 일반 텍스트(콤보/버튼/리스트 본문) -->
    <Style x:Key="ReaderBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardMediumFontFamily}"/>
        <Setter Property="FontSize" Value="14.67"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <!-- 라벨(카드/토글) -->
    <Style x:Key="ReaderLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardMediumFontFamily}"/>
        <Setter Property="FontSize" Value="13.0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}"/>
    </Style>

    <!-- 리스트 테이블 컬럼 헤더 : 토스/핀테크 표준 미디엄 다크 슬레이트(#4E5968) 12.67px -->
    <Style x:Key="ReaderTableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardMediumFontFamily}"/>
        <Setter Property="FontSize" Value="12.67"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TblHdrTextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 리스트 테이블 데이터 셀 : 선명하고 또렷한 딥 차콜(#191F28) 13.0px 실데이터 텍스트 -->
    <Style x:Key="ReaderTableCellTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="13.0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TblBodyTextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        작은 텍스트(빈 상태 문구 등)
    -->
    <Style x:Key="ReaderSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFontFamily}"/>
        <Setter Property="FontSize" Value="13.33"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TblBodyTextBrush}"/>
    </Style>

</ResourceDictionary>
