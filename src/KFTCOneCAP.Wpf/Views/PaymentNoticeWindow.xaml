<Window x:Class="KFTCOneCAP.Wpf.Views.PaymentNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:KFTCOneCAP.Wpf.Views.Controls"
        mc:Ignorable="d"
        Title="결제 알림"
        Width="750" Height="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">
    <!--
        development_plan.md P13-3: Owner를 설정하지 않는다(홈 화면을 Owner로 지정하면 알림창을 띄울 때
        홈 화면까지 활성화되어 PRD §5.1을 위반한다). 상태 전환은 이 창을 재생성하지 않고 State 변경 +
        전환 애니메이션으로만 처리한다(아래 ApplyState).

        ===== 자산 구조(2026-08-21 재구성, P13-1 "수정" 단락) =====
        이전에는 상태별로 리더기+화살표가 합성된 배경 이미지(BG_IMG_IC/MS/PROCESSING.png)를 통째로
        크로스페이드했지만, 지금은 3개 레이어로 분리한다.
          1. 정지 리더기(ReaderImage) — IC/FALLBACK/PROCESSING 3개 상태 모두 동일, 교체·페이드 없음.
          2. 화살표/로딩 인디케이터(OverlayHost) — 상태 전환 시 이전 것 페이드아웃 → 새 것 페이드인.
          3. 카드(CardImage, 2026-08-21부터 벡터 대신 실제 카드 이미지) — ArrowImage와 동일한 패턴으로
             전환 시 페이드아웃 → 페이드인 + 반복 슬라이드.
        문구(TextPanelA/B)는 기존과 동일하게 크로스페이드(겹쳐서 동시에 반대 방향 페이드)한다 —
        화살표/카드/로딩 인디케이터는 겹치지 않고 순차 페이드(페이드아웃 완료 후 페이드인)이므로 문구와는
        전환 방식이 다르다(development_plan.md 지시 원문: "화살표/카드/로딩 인디케이터는... 이전 것
        페이드아웃 → 새 것 페이드인").
        리더기/화살표 → 이미지 매핑은 Views/PaymentNoticeBackgroundSource.cs 한 곳에서만 이루어진다.
    -->
    <Grid>
        <Canvas Width="750" Height="650">

            <!-- ===== 정지 리더기 ===== -->
            <Image x:Name="ReaderImage"
                   Stretch="Uniform" Width="340" Height="226.67"
                   Canvas.Left="205" Canvas.Top="260" IsHitTestVisible="False"/>

            <!-- ===== 문구 크로스페이드 레이어 ===== -->
            <StackPanel x:Name="TextPanelA" Canvas.Left="0" Canvas.Top="38" Width="750" Opacity="1"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="TextAKr1" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TitleTextBrush}"/>
                <TextBlock x:Name="TextAKr2" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TitleTextBrush}" Margin="0,4,0,0"/>
                <TextBlock x:Name="TextAEn1" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,14,0,0"/>
                <TextBlock x:Name="TextAEn2" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel x:Name="TextPanelB" Canvas.Left="0" Canvas.Top="38" Width="750" Opacity="0"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="TextBKr1" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TitleTextBrush}"/>
                <TextBlock x:Name="TextBKr2" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TitleTextBrush}" Margin="0,4,0,0"/>
                <TextBlock x:Name="TextBEn1" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,14,0,0"/>
                <TextBlock x:Name="TextBEn2" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="16"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ===== 카드 (IC 삽입 / MS 스와이프 / 거래중 카드) ===== -->
            <Image x:Name="CardImage" Stretch="Uniform" Opacity="0" IsHitTestVisible="False"
                   Panel.ZIndex="5"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>

            <!-- ===== 화살표(IC/FALLBACK) / 로딩 인디케이터(PROCESSING) 오버레이 ===== -->
            <Grid x:Name="OverlayHost" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10">
                <Image x:Name="ArrowImage" Stretch="Uniform" Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                            <TranslateTransform x:Name="ArrowTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.Resources>
                        <!-- IC: 아래로 부드러운 바운스 (슬롯 방향) -->
                        <Storyboard x:Key="ArrowBounceDownStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="ArrowTranslate" Storyboard.TargetProperty="Y"
                                             From="0" To="10" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <!-- FALLBACK: 대각선 바운스 (MS 슬롯 방향으로 긁기 가이드) -->
                        <Storyboard x:Key="ArrowBounceLeftStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="ArrowTranslate" Storyboard.TargetProperty="X"
                                             From="0" To="-10" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ArrowTranslate" Storyboard.TargetProperty="Y"
                                             From="0" To="7" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Image.Resources>
                </Image>
                <controls:PaymentProcessingIndicator x:Name="ProcessingIndicator" Visibility="Collapsed"/>
            </Grid>

        </Canvas>

        <!-- ===== 취소 버튼 ===== -->
        <Button x:Name="CancelButton" Content="취소"
                Style="{StaticResource ReaderSecondaryButtonStyle}"
                Width="140" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Command="{Binding CancelCommand}"/>
    </Grid>
</Window>
