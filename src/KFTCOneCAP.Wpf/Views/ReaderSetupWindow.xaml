<Window x:Class="KFTCOneCAP.Wpf.Views.ReaderSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:KFTCOneCAP.Wpf.Controls"
        mc:Ignorable="d"
        Title="리더기 설정"
        Width="{StaticResource ReaderWindowWidth}"
        Height="{StaticResource ReaderWindowHeight}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        Loaded="ReaderSetupWindow_Loaded">
    <Window.Resources>
        <!--
            Phase 7(development_plan.md P7-3): 무결성 리스트/빈 상태/로딩 문구 세 Visibility를
            ReaderSetupViewModel.IntegrityState 하나에서 파생된 bool(IsEmptyState/IsLoadingState/
            IsLoadedState)로 바인딩한다 — 세 요소를 코드비하인드가 각각 대입하던 방식(상태가 어긋날
            여지가 있음)을 없애기 위함.
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <!--
        리더기 설정 화면 — 정적 레이아웃 (Phase 4, docs/home_reader_setup/ROADMAP.md).
        치수는 전부 Themes/Layout.xaml 리소스 키를 참조한다(리터럴 금지 — 홈 화면과 동일 규칙).

        창 크기: PRD 4.2 "최초 1회 레이아웃 계산 후 창 크기 확정". Phase 4~5에서는
        SizeToContent="WidthAndHeight"로 내부 컴포넌트별 고정 치수가 자연스럽게 전체 창 크기를
        결정하도록 했었으나, 2026-08-14(사용자 피드백: 창이 뜰 때마다 오버헤드가 있다)부터는 그
        결과값을 Layout.xaml의 ReaderWindowWidth/Height 리소스로 고정해 직접 참조한다(매번
        SizeToContent 레이아웃 패스를 태우지 않도록) — 상세 사유는 Layout.xaml 해당 키 주석 참고.

        버튼 클릭(초기화/상태체크/.../확인/취소) 로딩 스텁, 레지스트리 저장/dirty-check는
        Phase 5에서 구현 완료. AOP 뱃지, 포트 열기 토글의 실제 동작(PRD 4.8/4.11)은 외부 DLL
        연동과 함께 별도 PRD/단계에서 다루기로 확정(2026-08-14, docs/home_reader_setup/ROADMAP.md Phase 6 상단
        안내 참고) — "포트 열기" 토글은 자리만 빈 공간(Visibility=Hidden)으로 남겨 리더기2
        카드와 "멀티패드 여부" 위치를 맞췄다(아래 리더기1 카드 참고).
    -->
    <Border CornerRadius="{StaticResource ReaderMainCardCornerRadius}"
            Background="{StaticResource CardBgBrush}"
            Padding="{StaticResource ReaderMainCardPadding}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#1A202C" Opacity="0.12" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <!--
            2026-08-14 추가(Phase 5): 멀티패드 info 팝오버(PRD 4.10)를 담기 위해 루트를
            StackPanel 단독에서 Grid(+Popup)로 변경. Popup은 레이아웃 공간을 차지하지 않으므로
            기존 StackPanel 배치에는 영향 없다.
        -->
        <Grid>
        <StackPanel>
            <!-- ===================== 헤더 ===================== -->
            <!--
                2026-08-14 수정(사용자 피드백): Phase 4에서는 홈 화면의 "리더기 설정" 카드
                아이콘(카드리더 단말기 상세 벡터)을 그대로 재사용했으나, 스크린샷 확대 실측 결과
                실제 헤더 아이콘은 그와 다른 단순한 그리드 형태였다 — 아래 Path는 더 이상 홈 화면
                아이콘과 공유하지 않고 이 화면 전용의 단순 그리드 글리프를 사용한다.
            -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="{StaticResource ReaderHeaderIconBoxSize}" Height="{StaticResource ReaderHeaderIconBoxSize}"
                        Background="{StaticResource Blue500Brush}"
                        CornerRadius="{StaticResource ReaderHeaderIconCornerRadius}"
                        VerticalAlignment="Top">
                    <!--
                        2026-08-14 재설계(사용자 피드백: "아이콘이 부자연스럽다, 더 이쁘고 자연스럽게"):
                        HomeWindow.xaml ReaderSetupCardButton과 완전히 동일한 지오메트리(대칭 재설계
                        버전)를 공유한다 — 상세 사유는 그쪽 주석 참고.
                    -->
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="28" Height="28">
                            <Path Fill="White">
                                <Path.Data>
                                    <GeometryGroup FillRule="EvenOdd">
                                        <RectangleGeometry Rect="4.5,2.25,19,23.5" RadiusX="3" RadiusY="3"/>
                                        <RectangleGeometry Rect="7.5,5.25,13,8" RadiusX="1.5" RadiusY="1.5"/>
                                        <RectangleGeometry Rect="7.5,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="12.3,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="17.1,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="7.5,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="12.3,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="17.1,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                        <RectangleGeometry Rect="8.5,23,11,1.2" RadiusX="0.6" RadiusY="0.6"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="리더기 설정" Style="{StaticResource ReaderHeaderTitleTextStyle}"/>
                    <TextBlock Text="리더기 연결 및 제어 설정을 관리합니다" Style="{StaticResource ReaderHeaderSubtitleTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,14,0,14"/>

            <!-- ===================== 포트 설정 ===================== -->
            <Border Background="{StaticResource ReaderSubCardBgBrush}"
                    CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                    Padding="{StaticResource ReaderSubCardPadding}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="{StaticResource ReaderSectionBarWidth}" Height="{StaticResource ReaderSectionBarHeight}"
                                Background="{StaticResource Blue500Brush}" CornerRadius="2" VerticalAlignment="Center"/>
                        <TextBlock Text="포트 설정" Style="{StaticResource ReaderSectionTitleTextStyle}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 리더기1 카드 -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource ReaderBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                            MinHeight="{StaticResource ReaderCardMinHeight}"
                            Padding="{StaticResource ReaderCardPadding}">
                        <StackPanel>
                            <!-- 상단: 번호뱃지 + 라벨/콤보 + 포트열기/멀티패드 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 번호 뱃지 -->
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 라벨/콤보 -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 포트열기/멀티패드 -->
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="{StaticResource ReaderBadgeSize}" Height="{StaticResource ReaderBadgeSize}"
                                        Background="{StaticResource Blue500Brush}" CornerRadius="{StaticResource ReaderBadgeCornerRadius}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="1" Foreground="White" FontFamily="{StaticResource PretendardFontFamily}"
                                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="리더기1 - COM 포트" Style="{StaticResource ReaderLabelTextStyle}"/>
                                    <!--
                                        2026-08-14 수정(Phase 5 보완, 사용자 피드백): SelectedIndex="0"
                                        하드코딩(=항상 "COM 01" 기본 선택)을 제거 — 초기 선택은
                                        Views/ReaderSetupWindow.xaml.cs Loaded의 LoadFromRegistry()가
                                        레지스트리 값(있으면 그 값, 없으면 "미사용")으로 명시적으로
                                        선택한다.
                                    -->
                                    <ComboBox x:Name="Reader1PortCombo" Width="{StaticResource ReaderComboWidth}" Margin="0,8,0,0"
                                              IsEnabled="{Binding GlobalEnabled}"
                                              SelectedValuePath="Content" SelectedValue="{Binding Reader1PortSelection, Mode=TwoWay}">
                                        <ComboBoxItem Content="COM 01"/>
                                        <ComboBoxItem Content="미사용"/>
                                    </ComboBox>
                                </StackPanel>

                                <!--
                                    포트열기/멀티패드 그룹. "포트 열기"는 지시에 따라 이번 Phase에서
                                    토글을 만들지 않는다 — 라벨/토글/info 자리를 Visibility="Hidden"
                                    빈 공간으로만 남겨(ReaderPortOpenPlaceholderWidth) 리더기2 카드의
                                    "멀티패드 여부" 위치와 좌우가 어긋나지 않게 했다.
                                -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Width="{StaticResource ReaderPortOpenPlaceholderWidth}"
                                                Visibility="Hidden" HorizontalAlignment="Right">
                                        <TextBlock Text="포트 열기" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                                        <ToggleButton Style="{StaticResource ModernToggleSwitchStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource InfoButtonStyle}" Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource ReaderToggleGroupGapMargin}">
                                        <TextBlock Text="멀티패드 여부" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="Reader1MultipadToggle" Style="{StaticResource ModernToggleSwitchStyle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      IsEnabled="{Binding Reader1CardEnabled}" IsChecked="{Binding Reader1Multipad, Mode=TwoWay}"/>
                                        <Button x:Name="Reader1MultipadInfoButton" Style="{StaticResource InfoButtonStyle}"
                                                Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                                Click="MultipadInfoButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 하단: 액션 버튼 5개 -->
                            <StackPanel x:Name="Reader1ActionButtonsPanel" Orientation="Horizontal" Margin="42,10,0,0"
                                        IsEnabled="{Binding Reader1CardEnabled}">
                                <Button Content="{Binding Reader1InitButton.Content}" Command="{Binding Reader1InitButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader1InitButton.IsLoading}"/>
                                <Button Content="{Binding Reader1StatusCheckButton.Content}" Command="{Binding Reader1StatusCheckButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader1StatusCheckButton.IsLoading}"/>
                                <Button Content="{Binding Reader1KeyDownloadButton.Content}" Command="{Binding Reader1KeyDownloadButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader1KeyDownloadButton.IsLoading}"/>
                                <Button Content="{Binding Reader1IntegrityCheckButton.Content}" Command="{Binding Reader1IntegrityCheckButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader1IntegrityCheckButton.IsLoading}"/>
                                <Button Content="{Binding Reader1UpdateButton.Content}" Command="{Binding Reader1UpdateButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader1UpdateButton.IsLoading}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 리더기2 카드 -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource ReaderBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                            MinHeight="{StaticResource ReaderCardMinHeight}"
                            Padding="{StaticResource ReaderCardPadding}"
                            Margin="{StaticResource ReaderCardGapMargin}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 리더기2는 AOP 미적용 시(원본 기본) 비활성 회색 뱃지 — PRD 4.4 -->
                                <Border Grid.Column="0" Width="{StaticResource ReaderBadgeSize}" Height="{StaticResource ReaderBadgeSize}"
                                        Background="#BEC7D1" CornerRadius="{StaticResource ReaderBadgeCornerRadius}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="2" Foreground="White" FontFamily="{StaticResource PretendardFontFamily}"
                                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="리더기2 - COM 포트" Style="{StaticResource ReaderLabelTextStyle}"/>
                                    <!-- 2026-08-14 수정: 위 Reader1PortCombo와 동일 사유로 SelectedIndex 하드코딩 제거. -->
                                    <ComboBox x:Name="Reader2PortCombo" Width="{StaticResource ReaderComboWidth}" Margin="0,8,0,0"
                                              IsEnabled="{Binding GlobalEnabled}"
                                              SelectedValuePath="Content" SelectedValue="{Binding Reader2PortSelection, Mode=TwoWay}">
                                        <ComboBoxItem Content="미사용"/>
                                        <ComboBoxItem Content="COM 01"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 리더기2는 "포트 열기" 토글 자체가 UI에 없음(PRD 4.4, 원본 사양) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="멀티패드 여부" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="Reader2MultipadToggle" Style="{StaticResource ModernToggleSwitchStyle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  IsEnabled="{Binding Reader2CardEnabled}" IsChecked="{Binding Reader2Multipad, Mode=TwoWay}"/>
                                    <Button x:Name="Reader2MultipadInfoButton" Style="{StaticResource InfoButtonStyle}"
                                            Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                            Click="MultipadInfoButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="Reader2ActionButtonsPanel" Orientation="Horizontal" Margin="42,10,0,0"
                                        IsEnabled="{Binding Reader2CardEnabled}">
                                <Button Content="{Binding Reader2InitButton.Content}" Command="{Binding Reader2InitButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader2InitButton.IsLoading}"/>
                                <Button Content="{Binding Reader2StatusCheckButton.Content}" Command="{Binding Reader2StatusCheckButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader2StatusCheckButton.IsLoading}"/>
                                <Button Content="{Binding Reader2KeyDownloadButton.Content}" Command="{Binding Reader2KeyDownloadButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader2KeyDownloadButton.IsLoading}"/>
                                <Button Content="{Binding Reader2IntegrityCheckButton.Content}" Command="{Binding Reader2IntegrityCheckButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader2IntegrityCheckButton.IsLoading}"/>
                                <Button Content="{Binding Reader2UpdateButton.Content}" Command="{Binding Reader2UpdateButton.ExecuteCommand}"
                                        Style="{StaticResource ReaderButtonStyle}"
                                        Width="{StaticResource ReaderActionButtonWidth}" Height="{StaticResource ReaderActionButtonHeight}"
                                        Margin="{StaticResource ReaderActionButtonGapMargin}"
                                        controls:ButtonLoadingHelper.IsLoading="{Binding Reader2UpdateButton.IsLoading}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===================== 무결성 체크 정보 ===================== -->
            <Border Background="{StaticResource ReaderSubCardBgBrush}"
                    CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                    Padding="{StaticResource ReaderSubCardPadding}"
                    Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="{StaticResource ReaderSectionBarWidth}" Height="{StaticResource ReaderSectionBarHeight}"
                                Background="{StaticResource Blue500Brush}" CornerRadius="2" VerticalAlignment="Center"/>
                        <TextBlock Text="무결성 체크 정보" Style="{StaticResource ReaderSectionTitleTextStyle}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- 조회기간 콤보 + 조회 버튼 -->
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="QueryPeriodCombo" Width="{StaticResource ReaderQueryComboWidth}"
                                  IsEnabled="{Binding GlobalEnabled}"
                                  SelectedValuePath="Content" SelectedValue="{Binding QueryPeriodSelection, Mode=TwoWay}">
                            <ComboBoxItem Content="오늘"/>
                            <ComboBoxItem Content="7일"/>
                            <ComboBoxItem Content="30일"/>
                            <ComboBoxItem Content="100일"/>
                        </ComboBox>
                        <!-- 2026-08-14 변경: "확인" 전용 진한 파랑(PrimaryButtonStyle) 대신 액션 버튼과 동일한 연한 파랑 스타일(ReaderButtonStyle) 사용(스크린샷 실측) -->
                        <Button x:Name="QueryButton" Content="{Binding QueryButtonContent}" Command="{Binding QueryCommand}"
                                Style="{StaticResource ReaderButtonStyle}"
                                Width="{StaticResource ReaderQueryButtonWidth}" Height="{StaticResource ReaderQueryButtonHeight}"
                                Margin="10,0,0,0" IsEnabled="{Binding GlobalEnabled}"
                                controls:ButtonLoadingHelper.IsLoading="{Binding QueryButtonIsLoading}"/>
                    </StackPanel>

                    <!-- 리스트: 헤더 + 본문(고정 높이 166, Phase 4는 항상 빈 상태) -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource TblBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Margin="0,12,0,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource ReaderListHeaderHeightGridLength}"/>
                                <RowDefinition Height="{StaticResource ReaderListHeightGridLength}"/>
                            </Grid.RowDefinitions>

                            <!-- 헤더: PRD 4.6 실측 컬럼 문구/폭 비율 -->
                            <Border x:Name="TableHeaderBorder" Grid.Row="0" Background="{StaticResource TblHdrBgBrush}"
                                    BorderBrush="{StaticResource TblHdrLineBrush}" BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="23*"/>
                                        <ColumnDefinition Width="12*"/>
                                        <ColumnDefinition Width="10*"/>
                                        <ColumnDefinition Width="16*"/>
                                        <ColumnDefinition Width="21*"/>
                                        <ColumnDefinition Width="18*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="체크일시" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Border Grid.Column="0" Width="1" Height="14" Background="{StaticResource TblHdrLineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                    <TextBlock Grid.Column="1" Text="포트" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Border Grid.Column="1" Width="1" Height="14" Background="{StaticResource TblHdrLineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                    <TextBlock Grid.Column="2" Text="결과" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Border Grid.Column="2" Width="1" Height="14" Background="{StaticResource TblHdrLineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                    <TextBlock Grid.Column="3" Text="모듈ID" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Border Grid.Column="3" Width="1" Height="14" Background="{StaticResource TblHdrLineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                    <TextBlock Grid.Column="4" Text="리더기식별번호" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Border Grid.Column="4" Width="1" Height="14" Background="{StaticResource TblHdrLineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                                    <TextBlock Grid.Column="5" Text="POS식별번호" Style="{StaticResource ReaderTableHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!--
                                본문: Phase 5(ROADMAP.md) — 조회 버튼 클릭 시 더미 데이터로 채워지는
                                ItemsControl(가시 3행 고정 + ScrollViewer, PRD 4.3/4.6)로 교체.
                                데이터가 없는 초기 상태는 기존과 동일하게 빈 상태 문구를 유지하고,
                                조회 중(2초)에는 "조회 중입니다..." 로 전환한다. 세 상태는
                                Views/ReaderSetupWindow.xaml.cs QueryButton_Click 에서 Visibility로 전환.
                            -->
                            <Border Grid.Row="1" CornerRadius="0,0,8,8">
                                <ScrollViewer x:Name="IntegrityScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="IntegrityScrollViewer_ScrollChanged">
                                    <Grid>
                                        <ItemsControl x:Name="IntegrityListItemsControl" ItemsSource="{Binding IntegrityRows}"
                                                      Visibility="{Binding IsLoadedState, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border SnapsToDevicePixels="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource TblRowHoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Height="36">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="23*"/>
                                                                <ColumnDefinition Width="12*"/>
                                                                <ColumnDefinition Width="10*"/>
                                                                <ColumnDefinition Width="16*"/>
                                                                <ColumnDefinition Width="21*"/>
                                                                <ColumnDefinition Width="18*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding CheckTime}"
                                                                       Style="{StaticResource ReaderTableCellTextStyle}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Port}"
                                                                       Style="{StaticResource ReaderTableCellTextStyle}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            <Border Grid.Column="2" Background="{Binding ResultBackground}"
                                                                    CornerRadius="4" Padding="8,2"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultForeground}"
                                                                           FontFamily="{StaticResource PretendardFontFamily}" FontSize="11.5" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding ModuleId}"
                                                                       Style="{StaticResource ReaderTableCellTextStyle}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding ReaderId}"
                                                                       Style="{StaticResource ReaderTableCellTextStyle}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding PosId}"
                                                                       Style="{StaticResource ReaderTableCellTextStyle}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="IntegrityEmptyText" Text="조회된 무결성 체크 정보가 없습니다."
                                                   Style="{StaticResource ReaderSmallTextStyle}"
                                                   Foreground="{StaticResource TblEmptyTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <TextBlock x:Name="IntegrityLoadingText" Text="조회 중입니다..."
                                                   Style="{StaticResource ReaderSmallTextStyle}"
                                                   Foreground="{StaticResource TblEmptyTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLoadingState, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===================== 확인 / 취소 ===================== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="ConfirmButton" Content="확인" Style="{StaticResource PrimaryButtonStyle}"
                        Width="{StaticResource ReaderBottomBtnW}" Height="{StaticResource ReaderBottomBtnH}"
                        FontSize="{StaticResource ReaderBottomBtnFontSize}" Padding="{StaticResource ReaderBottomBtnPadding}"
                        IsEnabled="{Binding GlobalEnabled}"
                        Click="ConfirmButton_Click"/>
                <Button x:Name="CancelButton" Content="취소" Style="{StaticResource ReaderSecondaryButtonStyle}"
                        Width="{StaticResource ReaderBottomBtnW}" Height="{StaticResource ReaderBottomBtnH}"
                        FontSize="{StaticResource ReaderBottomBtnFontSize}" Padding="{StaticResource ReaderBottomBtnPadding}"
                        Margin="{StaticResource ReaderBottomBtnGapMargin}"
                        IsEnabled="{Binding GlobalEnabled}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!--
            멀티패드 info 팝오버(PRD 4.10) — 두 버튼(리더기1/2)이 공유하는 단일 Popup.
            PlacementTarget을 클릭된 버튼으로 바꿔가며 재사용한다(Views/ReaderSetupWindow.xaml.cs
            MultipadInfoButton_Click 참고). "포트 열기" info 버튼은 자리 자체가 Hidden이라
            이번 Phase에서 배선하지 않는다.
        -->
        <Popup x:Name="MultipadInfoPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom">
            <Border Background="White" BorderBrush="{StaticResource TblBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" MaxWidth="260" Margin="0,6,0,0"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="멀티패드 여부" Style="{StaticResource ReaderSectionTitleTextStyle}" FontSize="13.33"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource ReaderSmallTextStyle}" TextWrapping="Wrap">
                        <Run Text="멀티패드 여부 설정"/><LineBreak/>
                        <Run Text="· ON : QR 기능 사용 가능"/><LineBreak/>
                        <Run Text="· OFF : QR 기능 사용 불가"/><LineBreak/>
                        <Run Text="※스캐너가 부착된 리더기의 경우에도 ON 설정"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Border>
</Window>
