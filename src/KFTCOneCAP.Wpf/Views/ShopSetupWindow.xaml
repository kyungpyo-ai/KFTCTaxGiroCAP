<Window x:Class="KFTCOneCAP.Wpf.Views.ShopSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="가맹점 설정"
        Width="{StaticResource ReaderWindowWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        Loaded="ShopSetupWindow_Loaded"
        Closed="ShopSetupWindow_Closed"
        Closing="ShopSetupWindow_Closing">
    <!--
        가맹점 설정 화면(Phase 23, docs/operations/development_plan.md P23-3).
        원본 MFC(docs/operations/screenshots/shop_setup.png)는 탭 4개짜리 화면이지만, PRD.md §2.1
        확정대로 이번 범위는 탭 없이 단일 화면 + 섹션 카드 2개(결제 설정/시스템 설정)다.
        2026-09-02 정정 — 기존에는 "장치 정보" 섹션을 따로 두고 카드입력 타임아웃을 거기 넣었으나,
        섹션 하나만 남기기엔 항목이 1개뿐이라 화면이 어색하다는 지적(사용자)에 따라 "결제 설정"
        섹션 안(금융결제원 서버/키오스크 고유번호 아래 새 줄)으로 옮기고 "장치 정보" 섹션 자체를
        없앴다 — PRD.md §2.1 표도 2섹션 구성으로 갱신했다(코드보다 PRD를 먼저 갱신).
        헤더 아이콘/문구, 섹션 카드 스타일, 확인/취소 버튼 배치는 ReaderSetupWindow.xaml의 리소스를
        그대로 재사용한다(같은 디자인 시스템).
    -->
    <Border CornerRadius="{StaticResource ReaderMainCardCornerRadius}"
            Background="{StaticResource CardBgBrush}"
            Padding="{StaticResource ReaderMainCardPadding}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#1A202C" Opacity="0.12" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <!--
            2026-09-02 추가(Phase 23 후속, 정보 버튼 6종) — 필드별 안내 팝오버(아래 FieldInfoPopup)를
            담기 위해 루트를 StackPanel 단독에서 Grid(+Popup)로 변경. ReaderSetupWindow.xaml의
            멀티패드 팝오버와 동일 패턴. Popup은 레이아웃 공간을 차지하지 않으므로 기존 StackPanel
            배치에는 영향 없다.
        -->
        <Grid>
        <StackPanel>
            <!-- ===================== 헤더 ===================== -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="{StaticResource ReaderHeaderIconBoxSize}" Height="{StaticResource ReaderHeaderIconBoxSize}"
                        Background="{StaticResource Blue500Brush}"
                        CornerRadius="{StaticResource ReaderHeaderIconCornerRadius}"
                        VerticalAlignment="Top">
                    <!-- HomeWindow.xaml ShopSetupCardButton과 동일한 집 모양 지오메트리 재사용 -->
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="28" Height="28">
                            <Path Fill="White">
                                <Path.Data>
                                    <GeometryGroup FillRule="EvenOdd">
                                        <PathGeometry Figures="M14,3 L26,11 L2,11 Z"/>
                                        <RectangleGeometry Rect="3.5,11,21,15"/>
                                        <RectangleGeometry Rect="10.5,17.5,6,8.5"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="가맹점 설정" Style="{StaticResource ReaderHeaderTitleTextStyle}"/>
                    <TextBlock Text="가맹점 및 서버 연결 설정을 관리합니다" Style="{StaticResource ReaderHeaderSubtitleTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,14,0,14"/>

            <!--
                2026-09-02 정정 — 창 전체 높이를 리더기 설정 화면(744x820)에 강제로 맞추지 않는다
                (SizeToContent="Height" 유지, 위 Window 선언 참고). 섹션 카드 패딩/카드 간 여백은
                리더기 설정 화면과 동일한 리소스(ReaderSubCardPadding, 0,12,0,0 카드 간 여백)를 그대로
                쓴다 — "확인/취소 버튼 위아래 간격만 리더기 설정 화면과 일치시켜 달라"는 요청에 맞춰
                버튼 위 여백(Margin="0,14,0,0")과 버튼 아래 여백(메인 카드 Padding/Margin, 위와 동일)을
                ReaderSetupWindow.xaml과 같은 값으로 맞췄다.

                ComboBox/TextBox 높이(40px)와 2열 배치 간격(결제 설정 20px / 시스템 설정 18px)은
                원본 MFC 소스(2026-09-02 최종 확정, C:\Project\MerchantSetup_OnPaintIcons_Clean_CP949\
                ShopSetupDlg.cpp)의 실제 레이아웃 계산 상수를 그대로 가져왔다 — 이 다이얼로그는
                .rc 리소스에 고정 좌표가 없고(전부 자리표시자 10,10,10,10) OnPaint 기반으로 런타임에
                레이아웃을 계산한다: `ApplyLayoutTab0/Tab1`의 `CTRL_H = SX(bCompact ? 32 : 40)`
                (비압축 모드 40px, 콤보/에딧 공용 — `NormalizeInputHeightsToCombo`로 에딧 높이를 콤보에
                맞춤), `colGap = bCompact ? 12 : 20`(결제 설정 2열 간격), `cG = bCompact ? 10 : 18`
                (시스템 설정 2열 간격). 전역 SkinnedComboBoxStyle/SkinnedTextBoxStyle 자체는 건드리지
                않고 이 화면에서만 로컬로 오버라이드했다(리더기 설정 화면 회귀 방지).

                2026-09-02 추가 수정 — MinHeight="40"만으로는 ComboBox와 TextBox의 실제 렌더링
                높이가 일치하지 않았다(스크린샷 픽셀 실측으로 확인: ComboBox 39px, TextBox 48px).
                원인은 두 스타일의 FontSize가 다르기 때문(SkinnedComboBoxStyle=ReaderComboFontSize
                15.33 vs SkinnedTextBoxStyle=18.67) — TextBox는 줄높이(ascent+descent) 확보를 위해
                MinHeight를 넘어 자연스럽게 더 크게 그려진다(TextBox.xaml 상단 주석에 같은 현상의
                과거 기록 있음). 전역 스타일은 그대로 두고, 이 화면의 TextBox 3개에만 로컬로
                FontSize를 ComboBox와 같은 값(ReaderComboFontSize)으로 낮추고 Height="40"(고정)을
                줘서 두 컨트롤이 완전히 같은 높이로 렌더링되게 했다(스크린샷 픽셀 재실측으로 확인 완료).

                2026-09-02 재검증(2차 라운드) — 스크린샷을 확대해 재확인한 결과 Height="40" 고정 +
                FontSize=ReaderComboFontSize 조합에서 텍스트 상/하가 잘리지 않는 것을 다시 확인했다
                (ScrollViewer PART_ContentHost가 Padding "10,6"만큼만 잉크 영역을 차지하고, 15.33px
                폰트의 실제 줄높이가 40-12=28px 안에 들어간다). 값 변경 없이 그대로 유지한다.

                2026-09-02 3차 정정 — 위 두 번의 "Height=40이면 잘리지 않는다"는 판단은 모두 틀렸다.
                사용자가 실제 화면을 캡처한 스크린샷에서 KioskIdTextBox("ABCDEFGHIJKLMNOPQRST")와
                CardReadTimeoutTextBox("120")의 글자 아래쪽이 박스 테두리에 바짝 붙어 잘리는 것이
                육안으로 명백히 보였다. 이전 두 라운드는 전부 대문자/숫자 위주 텍스트로만 확인했는데,
                실제 문제는 소문자 디센더(g/j/p 등)에서만 드러난다 — 대문자·숫자·한글은 디센더가
                없거나 짧아서 25~28px 잉크 영역 안에 우연히 들어맞았을 뿐이다. 실제로
                "abcdefghijklmnop가나다"를 입력해 스크린샷을 4~5배 확대(NearestNeighbor)해서
                픽셀 단위로 비교한 결과, Height="40" 고정에서는 g/j/p의 디센더 아래쪽이 명확히
                잘려나갔다(둥근 디센더 loop 없이 평평하게 잘린 모양).

                원인 분석 — TextBox의 ControlTemplate은 `<ScrollViewer x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding
                VerticalContentAlignment}"/>`이고 VerticalContentAlignment=Center다. Height를
                고정값으로 강제하면 ScrollViewer/TextBoxView가 실제로 필요로 하는 잉크 높이보다 작은
                공간에 강제로 눌려 들어가고, VerticalAlignment=Center는 이 부족한 공간을 위아래로
                "가운데 정렬"만 할 뿐 늘려주지 않으므로 넘치는 디센더가 그대로 잘린다. Height 없이
                MinHeight만 썼을 때 TextBox가 자연스럽게 48px까지 커졌던 과거 실측(TextBox.xaml 상단
                주석, FontSize=18.67 기준)이 이미 이 사실을 가리키고 있었다.

                수정 — Height/MinHeight를 40 → 48로 올려서(ComboBox/TextBox 세 컨트롤 전부 동일하게
                48로 동기화) 다시 테스트했다. "abcdefghijklmnop가나다"(KioskIdTextBox)와 "120"
                (CardReadTimeoutTextBox) 모두 디센더 아래로 테두리까지 육안으로 확인 가능한 여백이
                남는 것을 스크린샷 확대로 확인했다(박스 하단 여백이 눈에 띄게 남아 딱 맞아떨어지는
                수준이 아니다). ComboBox도 같은 48로 맞춰서 세 컨트롤의 테두리 y좌표가 크롭
                스크린샷에서 완전히 일치하는 것을 확인했다. 원본 MFC의 CTRL_H=40과는 다른 값이지만,
                WPF(Pretendard 폰트, ClearType 렌더링)가 원본 MFC GDI 렌더링보다 세로 잉크 공간을
                더 요구하기 때문에 의도적으로 다르게 둔다 — 텍스트 잘림 방지가 원본 픽셀값 일치보다
                우선한다(사용자 지시).
            -->
            <!-- ===================== 결제 설정 (PRD §2.2/§2.3/§2.4) ===================== -->
            <Border Background="{StaticResource ReaderSubCardBgBrush}"
                    CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                    Padding="{StaticResource ReaderSubCardPadding}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="{StaticResource ReaderSectionBarWidth}" Height="{StaticResource ReaderSectionBarHeight}"
                                Background="{StaticResource Blue500Brush}" CornerRadius="2" VerticalAlignment="Center"/>
                        <TextBlock Text="결제 설정" Style="{StaticResource ReaderSectionTitleTextStyle}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,0,0,10"/>

                    <!--
                        2026-09-02 정정 — 원본(screenshots/shop_setup.png) "서버 설정" 섹션은
                        "금융결제원 서버"와 "포트번호"가 한 줄에 나란히(2열) 배치돼 있다. 이 화면의
                        두 번째 필드는 포트번호가 아니라 "키오스크 고유번호"(PRD.md §2.3 확정)지만,
                        같은 2열 배치 구조는 그대로 재현한다.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="금융결제원 서버" Style="{StaticResource ReaderLabelTextStyle}"/>
                                <Button x:Name="VanModeInfoButton" Style="{StaticResource InfoButtonStyle}"
                                        Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                        Tag="VanMode" Click="FieldInfoButton_Click"/>
                            </StackPanel>
                            <!--
                                PRD §2.2 — ComboBox는 표시 문구만 바인딩하고 저장값(R/OT/IT)은
                                ShopSetupViewModel 안에서만 매핑한다("R" 같은 리터럴이 여기 등장하지 않는다).
                            -->
                            <ComboBox x:Name="VanModeCombo" Height="48" Margin="0,8,0,0"
                                      ItemsSource="{Binding VanModeOptions}"
                                      SelectedItem="{Binding VanModeSelection, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="키오스크 고유번호" Style="{StaticResource ReaderLabelTextStyle}"/>
                                <Button x:Name="KioskIdInfoButton" Style="{StaticResource InfoButtonStyle}"
                                        Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                        Tag="KioskId" Click="FieldInfoButton_Click"/>
                            </StackPanel>
                            <TextBox x:Name="KioskIdTextBox" Style="{StaticResource SkinnedTextBoxStyle}"
                                     FontSize="{StaticResource ReaderComboFontSize}" Height="48" MinHeight="48" Margin="0,8,0,0"
                                     MaxLength="20"
                                     Text="{Binding KioskId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!--
                        2026-09-02 이동(사용자 지시) — 원래 "장치 정보" 섹션에 있던 카드입력
                        타임아웃을 이 섹션 안으로 옮겼다(섹션 자체는 없앴다). 원본은 이 필드가
                        한 줄 전체가 아니라 2열 중 왼쪽 절반만 쓴다(오른쪽은 "장치 연동 방식" 콤보,
                        이 화면 범위 밖) — 그 비율은 유지한다.
                    -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="카드입력 타임아웃(초)" Style="{StaticResource ReaderLabelTextStyle}"/>
                                <Button x:Name="CardReadTimeoutInfoButton" Style="{StaticResource InfoButtonStyle}"
                                        Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                        Tag="CardReadTimeout" Click="FieldInfoButton_Click"/>
                            </StackPanel>
                            <TextBox x:Name="CardReadTimeoutTextBox" Style="{StaticResource SkinnedTextBoxStyle}"
                                     FontSize="{StaticResource ReaderComboFontSize}" Height="48" MinHeight="48" Margin="0,8,0,0"
                                     MaxLength="9"
                                     Text="{Binding CardReadTimeoutSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== 시스템 설정 (PRD §2.5) ===================== -->
            <Border Background="{StaticResource ReaderSubCardBgBrush}"
                    CornerRadius="{StaticResource ReaderSubCardCornerRadius}"
                    Padding="{StaticResource ReaderSubCardPadding}"
                    Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="{StaticResource ReaderSectionBarWidth}" Height="{StaticResource ReaderSectionBarHeight}"
                                Background="{StaticResource Blue500Brush}" CornerRadius="2" VerticalAlignment="Center"/>
                        <TextBlock Text="시스템 설정" Style="{StaticResource ReaderSectionTitleTextStyle}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,0,0,10"/>

                    <!--
                        2026-09-02 정정 — 원본은 토글류(카드 감지 우선 거래/은련카드 자동 핀입력 등)를
                        세로로 쌓지 않고 2열로 배치한다(ShopSetupDlg.cpp ApplyLayoutTab1, 자동
                        리부팅/자동 업데이트가 1행에 나란히, 결제 화면 잠금이 2행 왼쪽에만). 18px 갭의
                        2열 Grid로 동일하게 재현한다.

                        2026-09-02 추가 정정(사용자 지시) — 각 행에서 라벨은 왼쪽, 토글은 그 열의
                        오른쪽 끝에 붙어야 한다(원본 shop_setup.png 실측). 기존에는 StackPanel
                        Horizontal로 라벨 바로 옆에 토글을 붙였는데, DockPanel로 바꿔 라벨을
                        DockPanel.Dock="Left", 토글을 DockPanel.Dock="Right"에 배치해 열 폭
                        전체(Grid.Column의 "*") 기준 오른쪽 끝으로 밀었다.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--
                            2026-09-02 정정(사용자 피드백) — DockPanel(LastChildFill="False")의
                            Dock="Right" 자식은 먼저 추가된 것이 가장 바깥쪽(오른쪽)에, 나중에 추가된
                            것이 안쪽(왼쪽)에 쌓인다. "? 버튼이 토글보다 오른쪽"이 되려면 Button을
                            ToggleButton보다 XAML 순서상 먼저 넣어야 한다(반대로 넣으면 토글이 바깥쪽,
                            버튼이 토글 왼쪽 안쪽에 붙는 회귀가 생긴다 — 실제로 한 번 겪었다). 간격
                            마진은 이제 ToggleButton 쪽에 둬서 "라벨 …(간격)… 버튼 …(간격)… 토글"
                            순서가 되게 한다.
                        -->
                        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="자동 리부팅" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                            <Button x:Name="AutoRebootInfoButton" DockPanel.Dock="Right" Style="{StaticResource InfoButtonStyle}"
                                    Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                    Tag="AutoReboot" Click="FieldInfoButton_Click"/>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoReboot, Mode=TwoWay}"/>
                        </DockPanel>

                        <DockPanel Grid.Row="0" Grid.Column="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="자동 업데이트" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                            <Button x:Name="AutoUpdateInfoButton" DockPanel.Dock="Right" Style="{StaticResource InfoButtonStyle}"
                                    Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                    Tag="AutoUpdate" Click="FieldInfoButton_Click"/>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoUpdate, Mode=TwoWay}"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="False" Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="결제 화면 잠금" Style="{StaticResource ReaderLabelTextStyle}" VerticalAlignment="Center"/>
                            <Button x:Name="KeyinDimInfoButton" DockPanel.Dock="Right" Style="{StaticResource InfoButtonStyle}"
                                    Margin="{StaticResource ReaderToggleInfoGapMargin}" VerticalAlignment="Center"
                                    Tag="KeyinDim" Click="FieldInfoButton_Click"/>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ModernToggleSwitchStyle}" VerticalAlignment="Center"
                                          IsChecked="{Binding KeyinDim, Mode=TwoWay}"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== 확인 / 취소 (ReaderSetupWindow.xaml과 동일한 위쪽 여백) ===================== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="ConfirmButton" Content="확인" Style="{StaticResource PrimaryButtonStyle}"
                        Width="{StaticResource ReaderBottomBtnW}" Height="{StaticResource ReaderBottomBtnH}"
                        FontSize="{StaticResource ReaderBottomBtnFontSize}" Padding="{StaticResource ReaderBottomBtnPadding}"
                        Click="ConfirmButton_Click"/>
                <Button x:Name="CancelButton" Content="취소" Style="{StaticResource ReaderSecondaryButtonStyle}"
                        Width="{StaticResource ReaderBottomBtnW}" Height="{StaticResource ReaderBottomBtnH}"
                        FontSize="{StaticResource ReaderBottomBtnFontSize}" Padding="{StaticResource ReaderBottomBtnPadding}"
                        Margin="{StaticResource ReaderBottomBtnGapMargin}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!--
            필드 안내 info 팝오버 — 필드 6개가 단일 Popup을 공유하고, 클릭한 버튼의 Tag에 따라
            제목/본문을 코드비하인드에서 갈아끼운다(ReaderSetupWindow.xaml MultipadInfoPopup과 동일
            패턴). 필드마다 Popup을 따로 두지 않은 이유는 XAML 중복(Border/CornerRadius/Padding 등
            동일 껍데기가 6번 반복)을 피하기 위함 — Views/ShopSetupWindow.xaml.cs
            FieldInfoButton_Click 참고.
        -->
        <Popup x:Name="FieldInfoPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom">
            <Border Background="White" BorderBrush="{StaticResource TblBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" MaxWidth="260" Margin="0,6,0,0"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock x:Name="FieldInfoTitleText" Style="{StaticResource ReaderSectionTitleTextStyle}" FontSize="13.33"/>
                    <TextBlock x:Name="FieldInfoBodyText" Margin="0,8,0,0" Style="{StaticResource ReaderSmallTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Border>
</Window>
