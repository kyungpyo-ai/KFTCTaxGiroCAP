<Window x:Class="KFTCOneCAP.Wpf.Views.PaymentScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:payment="clr-namespace:KFTCOneCAP.Wpf.ViewModels.Payment"
        xmlns:converters="clr-namespace:KFTCOneCAP.Wpf.Converters"
        mc:Ignorable="d"
        Title="결제"
        Width="{StaticResource PaymentWindowWidth}"
        Height="{StaticResource PaymentWindowHeight}"
        MinWidth="900" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        SourceInitialized="PaymentScreenWindow_SourceInitialized">
    <!--
        결제 화면(Phase 29 P29-6, docs/payment_relay/PRD.md §12/§12.5, development_plan.md "P29-6") —
        원캡이 스스로 국세 결제 3전문(501008/800000/902614)을 시작하는 화면. 이번 단계는 전문 간 필드
        연쇄를 구현하지 않고 임의값으로 전문 왕복 자체(프레이밍/POSITION/CP949/카드리딩 필드)를 검증한다
        (PRD §12.2). 이 창은 아직 홈 화면과 배선되지 않는다(P29-7이 별도로 연결) — App.xaml.cs의
        payment-screen-test 진단 인자, 또는 직접 인스턴스화로 연다.

        2026-09-18 사용자 지적으로 UI 재작업(2라운드) — 처음엔 DataGrid 표 + hex/CP949 원문 패널까지
        보여주는 "엔지니어 진단 화면"이었으나, 참고 이미지(docs/home_reader_setup/screenshots/pay_screen.png
        = docs/payment_relay/images/payment_screen.png)의 톤을 그대로 따르도록 다시 짰다:
        - 좌측: 필드 "레이블 위 + 둥근 테두리 입력창 아래" 카드가 반복되는 세로 스크롤 목록(요청, 편집 가능)
        - 우측: 초록 테두리 카드 + 상태 배지 + "레이블(회색, 왼쪽) — 값(굵게, 오른쪽)" 행 목록(응답, 읽기전용)
        원문 hex/텍스트 패널은 화면에서 완전히 뺐다(development_plan.md P29-6 원문 지시보다 이 사용자
        확정이 우선). 참고 이미지는 필드가 5~6개뿐인 일반 카드결제 화면이라 좌측이 2열 그리드로 끝나지만,
        이 화면은 전문당 필드가 9~53개라 좌측도 세로 스크롤 목록으로 만들었다 — 카드 스타일(레이블 위/값
        아래, 둥근 테두리)은 그대로 유지한다.

        2라운드 확정(같은 날) — 좌/우 분리를 SET 장소(kiosk 담당 여부) 기준으로 다시 정했다. 요청(좌측)
        패널에는 SET 장소에 kiosk가 포함된 필드만 들어간다(kiosk가 실제로 채워 보내는 값). 응답(우측)
        패널에는 kiosk가 없는 필드 중 원캡 담당을 뺀 나머지만 들어간다 — 단 800000의 #14(BIN)는 원캡
        담당이어도 응답에 보여준다(카드 정보 조회 전문의 유일한 목적이 그 조회 결과라서). 해당 없는
        필드는 "회색/공백"으로 두지 않고 목록에서 아예 뺀다(PaymentTelegramTabViewModel.RebuildRequestRows/
        RebuildResponseRows 참고) — 902614의 원캡 담당 8개(카드번호/PIN 등)는 이 예외에 해당하지 않아
        요청·응답 어디에도 나타나지 않는다.

        색상은 기존 Themes/*.xaml 리소스만 쓴다(새 팔레트를 만들지 않는다, PRD §12.5) — 참고 이미지의
        녹색 테두리/배지는 Buttons.xaml의 UpdateHoverTextBrush(#22C55E)/UpdateHoverBgBrush(#E8FFE8)를
        그대로 재사용했다(홈 화면 "최신 버전 업데이트" 버튼 호버 색과 동일 팔레트).
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!--
            탭 헤더(TabItem) 최소 재스타일 — 참고 이미지의 세그먼트 탭(연한 회색 배경 위 흰 알약형
            선택 탭)에 맞춰 배경(#F1F3F5, 아래 TabControl을 감싼 Border가 담당)+선택 시 흰 배경/파란
            텍스트, 비선택 시 회색 텍스트로 재현한다.
        -->
        <Style x:Key="PaymentTabItemStyle" TargetType="TabItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Blue500Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 요청 카드 값 입력 박스(참고 이미지의 둥근 테두리 입력창). 2026-09-18 확정 이후 요청 패널에는
             kiosk 담당 필드만 들어오므로 IsReadOnly는 항상 false다 — 아래 트리거는 형식상 남겨 둔다
             (다른 성격의 읽기전용 필드가 요청 패널에 들어오게 되면 재사용). -->
        <Style x:Key="RequestFieldBoxStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource TblBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TblAltRowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RequestFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
            <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TblEmptyTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 요청 카드 1개(필드 1개) — 참고 이미지의 "공급가액 / [1,000  원]" 카드와 같은 구성.
             2026-09-18 7라운드 — 폭을 256→220으로 줄여 한 줄에 3개가 들어가게 했다(사용자 지적: 탭을
             줄이는 대신 요청 필드 쪽이 가용 폭을 더 채워야 한다). -->
        <DataTemplate x:Key="RequestFieldCardTemplate" DataType="{x:Type payment:PosFieldRowViewModel}">
            <!-- 205에서는 실측 결과 2열까지만 들어가 160으로 더 줄였다(2026-09-18, 실제 화면으로 재확인). -->
            <StackPanel Width="160" Margin="0,0,14,14" ToolTip="{Binding TypeAndLengthTooltip}">
                <TextBlock Text="{Binding NumberAndName}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           TextTrimming="CharacterEllipsis" Margin="2,0,0,6"/>
                <Border Style="{StaticResource RequestFieldBoxStyle}">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RequestFieldTextBoxStyle}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 응답 행 1개(필드 1개) — 참고 이미지의 "거래 일시  260909110325" 행과 같은 구성(레이블 회색
             왼쪽, 값 굵게 오른쪽 + 얇은 구분선). IsCardReadingField(원캡 카드리딩 담당)는 연한 파랑으로
             구분한다. VAN 스텁 경고 배너·스텁 전용 강조(IsStubOverwritten)는 2026-09-18 사용자 지시로
             제거했다 — 실 VAN이 붙으면 어차피 의미 없어질 스텁 전용 표시라, 굳이 지금 강조하지 않는다. -->
        <DataTemplate x:Key="ResponseFieldRowTemplate" DataType="{x:Type payment:PosFieldRowViewModel}">
            <!-- 2026-09-18 사용자 지시 — 행 간격을 예전처럼 좁게(세로 Padding 7→4). -->
            <Border Padding="4,4" ToolTip="{Binding TypeAndLengthTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardReadingField}" Value="True">
                                <Setter Property="Background" Value="#E8F3FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,7,0,-7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NumberAndName}" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- 2026-09-18 사용자 지시 — 응답 값을 복사할 수 있어야 한다. TextBlock은 선택/복사가
                             안 되므로 읽기전용 TextBox로 바꾸되 테두리·배경을 없애 시각적으로는 그대로
                             레이블처럼 보이게 한다. -->
                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}" FontSize="12" FontWeight="Bold"
                                 Foreground="{StaticResource TitleTextBrush}" TextAlignment="Right" TextWrapping="Wrap"
                                 VerticalAlignment="Center" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 BorderThickness="0" Background="Transparent" Padding="0" Cursor="IBeam"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 요청 콘텐츠(탭 아래, 필드 카드 목록)의 공용 DataTemplate. Tabs 컬렉션 아이템
             (PaymentTelegramTabViewModel) 전부가 이 템플릿을 공유한다 — 탭이 3개라고 XAML을 3번
             반복하지 않는다. 응답 패널은 별도 Border로 분리했다(2026-09-18 3라운드 — 참고 이미지처럼
             탭 상단과 응답 패널 상단이 같은 높이에서 시작해야 하는데, 응답 패널이 이 템플릿(탭 콘텐츠)
             안에 있으면 탭 줄만큼 아래로 밀려 어긋난다). -->
        <DataTemplate x:Key="TelegramTabRequestContentTemplate" DataType="{x:Type payment:PaymentTelegramTabViewModel}">
            <DockPanel Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ResultOkTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ResultErrorTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="전송" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Width="140" Margin="0,0,8,0"
                                IsEnabled="{Binding IsSending, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="임의값 재생성" Command="{Binding RegenerateCommand}" Style="{StaticResource ReaderSecondaryButtonStyle}"
                                IsEnabled="{Binding IsSending, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="요청 필드 — kiosk가 채워 보내는 값(값 입력)"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,10" Foreground="{StaticResource CardTitleTextBrush}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0">
                    <ItemsControl ItemsSource="{Binding RequestRows}" ItemTemplate="{StaticResource RequestFieldCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="{StaticResource ReaderMainCardCornerRadius}"
            Background="{StaticResource CardBgBrush}"
            Padding="{StaticResource ReaderMainCardPadding}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#1A202C" Opacity="0.12" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <DockPanel>
            <!-- ===================== 헤더 ===================== -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="{StaticResource ReaderHeaderIconBoxSize}" Height="{StaticResource ReaderHeaderIconBoxSize}"
                        Background="{StaticResource Blue500Brush}"
                        CornerRadius="{StaticResource ReaderHeaderIconCornerRadius}"
                        VerticalAlignment="Top">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M4,6 L20,6 20,18 4,18 Z M4,9 L20,9 M7,13 L9,13 M7,15.5 L11,15.5"
                                  Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="결제" Style="{StaticResource ReaderHeaderTitleTextStyle}"/>
                    <TextBlock Text="국세 결제 3전문(501008/800000/902614)을 직접 전송하고 왕복을 확인합니다"
                               Style="{StaticResource ReaderHeaderSubtitleTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource FooterDividerBrush}" Margin="0,14,0,0"/>

            <!-- ===================== 탭+요청(좌) / 응답(우) — 같은 Grid 행에 나란히 둬서 탭 상단과
                 응답 패널 상단이 정확히 같은 높이에서 시작하게 한다(2026-09-18 3라운드 사용자 지적 —
                 참고 이미지처럼 탭 줄과 응답 카드 상단이 맞아야 한다). ===================== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <!-- 440으로 넓혔다가 사용자가 "이전 버전이 낫다"고 해서 380으로 원복(2026-09-18). -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== 좌측: 탭 + 요청(편집 가능) ===================== -->
                <DockPanel Grid.Column="0">
                    <!-- 2026-09-18 8라운드 정정(사용자가 손그림으로 재지적) — 탭을 고정폭으로 줄였더니
                         이번엔 반대로 요청 필드 영역(3열로 넓어진 뒤)보다 짧아져 버렸다. 탭 길이를
                         손으로 맞추려 하지 말고, 탭 줄이 다시 Grid.Column="0" 전체 폭(요청 필드 영역과
                         동일한 폭)을 채우도록 되돌린다 — UniformGrid로 탭 3개를 그 폭 안에서 균등폭으로
                         나누면 필드 카드가 몇 열이 되든 탭 줄과 자동으로 폭이 맞는다(하드코딩된 픽셀
                         값끼리 맞추는 것보다 이 방식이 안정적이다). -->
                    <Border DockPanel.Dock="Top" Background="#F1F3F5" CornerRadius="10" Padding="4">
                        <TabControl x:Name="TelegramTabControl" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    ItemContainerStyle="{StaticResource PaymentTabItemStyle}">
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type payment:PaymentTelegramTabViewModel}">
                                    <TextBlock Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <UniformGrid Rows="1" IsItemsHost="True" Background="Transparent"/>
                                </ControlTemplate>
                            </TabControl.Template>
                        </TabControl>
                    </Border>

                    <!-- TabControl.Template을 UniformGrid(헤더)만 남기도록 덮어썼으므로(위) 콘텐츠는 이
                         별도 ContentControl이 SelectedItem을 직접 참조해 그린다 — SelectedItem/
                         SelectedIndex는 Selector 레벨 속성이라 헤더 전용 템플릿으로 바꿔도 그대로
                         동작한다. -->
                    <ContentControl Content="{Binding ElementName=TelegramTabControl, Path=SelectedItem}"
                                     ContentTemplate="{StaticResource TelegramTabRequestContentTemplate}"/>
                </DockPanel>

                <!-- ===================== 우측: 응답(읽기전용, 초록 테두리 카드) ===================== -->
                <!-- DataContext를 선택된 탭으로 직접 맞춘다 — 더 이상 탭 콘텐츠 템플릿 안에 있지 않으므로
                     (위 주석 참고) 응답 바인딩(HasResponse/ResponseRows 등)이 자동으로 이어지지 않는다. -->
                <Border Grid.Column="2" BorderBrush="{StaticResource UpdateHoverTextBrush}" BorderThickness="1.5"
                        CornerRadius="16" Background="{StaticResource CardBgBrush}" Padding="18"
                        DataContext="{Binding ElementName=TelegramTabControl, Path=SelectedItem}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource ReaderSectionBarWidth}" Height="{StaticResource ReaderSectionBarHeight}"
                                        Background="{StaticResource UpdateHoverTextBrush}" CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="응답 정보" FontWeight="Bold" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource CardTitleTextBrush}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource TblAltRowBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusBadgeIsPositive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource UpdateHoverBgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusBadgeIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ResultErrorBgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TblEmptyTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBadgeIsPositive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource UpdateHoverTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBadgeIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ResultErrorTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Grid>
                            <TextBlock Text="아직 전송하지 않았습니다.&#x0a;좌측 '전송' 버튼을 누르면 응답이 여기에 채워집니다."
                                       Visibility="{Binding HasResponse, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                       Foreground="{StaticResource TblEmptyTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0"
                                          Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ResponseRows}" ItemTemplate="{StaticResource ResponseFieldRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
