<Window x:Class="KFTCOneCAP.Wpf.Views.StyleGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Style Gallery (Phase 1 개발용 검증 창)"
        Height="900" Width="1150"
        Background="{StaticResource HomeBgBrush}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Style Gallery — Phase 1 디자인 시스템 검증" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TitleTextBrush}" Margin="0,0,0,16"/>

            <!-- ===================== 색상 팔레트 ===================== -->
            <TextBlock Text="1. 색상 팔레트 (PRD 2.1)" FontSize="16" FontWeight="Bold" Margin="0,8,0,8"/>
            <WrapPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource HomeBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="HomeBg #F8FAFC" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="CardBg #FFFFFF" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource CardBorderBrush}"/>
                    <TextBlock Text="CardBorder #E8ECF2" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource CardBorderHoverBrush}"/>
                    <TextBlock Text="CardBorderHover #E2E8F0" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource CardFillPressedBrush}"/>
                    <TextBlock Text="CardFillPressed #D2E6FF" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TitleTextBrush}"/>
                    <TextBlock Text="TitleText #191F28" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource CardTitleTextBrush}"/>
                    <TextBlock Text="CardTitleText #333D4B" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="SubText #8B95A1" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource FooterDividerBrush}"/>
                    <TextBlock Text="FooterDivider #DCE2EA" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource Blue500Brush}"/>
                    <TextBlock Text="Blue500 #0064DD" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource DialogBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="DialogBg #F9FAFC" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource ReaderSubCardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="ReaderSubCardBg #FAFBFD" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource ReaderBorderBrush}"/>
                    <TextBlock Text="Border(리더기) #D6E4F7" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblBorderBrush}"/>
                    <TextBlock Text="TblBorder #D1D9E6" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblHdrBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="TblHdrBg #F0F3F8" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblHdrLineBrush}"/>
                    <TextBlock Text="TblHdrLine #D5DCE8" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblRowLineBrush}"/>
                    <TextBlock Text="TblRowLine #E4E8F0" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblAltRowBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"/>
                    <TextBlock Text="TblAltRow #FBFCFF" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblHdrTextBrush}"/>
                    <TextBlock Text="TblHdrText #4E5968" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblBodyTextBrush}"/>
                    <TextBlock Text="TblBodyText #191F28" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource TblEmptyTextBrush}"/>
                    <TextBlock Text="TblEmptyText #A0A8B4" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource ResultOkBgBrush}" BorderBrush="{StaticResource ResultOkTextBrush}" BorderThickness="1"/>
                    <TextBlock Text="결과 정상 칩 #E8FCF1/#15803D" FontSize="11"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,12" Width="140">
                    <Border Height="50" Background="{StaticResource ResultErrorBgBrush}" BorderBrush="{StaticResource ResultErrorTextBrush}" BorderThickness="1"/>
                    <TextBlock Text="결과 오류 칩 #FFEBEB/#DC2626" FontSize="11"/>
                </StackPanel>
            </WrapPanel>

            <!-- ===================== 타이포그래피 ===================== -->
            <TextBlock Text="2. 타이포그래피 (PRD 2.2)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="홈 타이틀 (19pt, ExtraBold→Bold 폴백) : KFTCOneCAP" Style="{StaticResource HomeTitleTextStyle}"/>
                    <TextBlock Text="홈 서브타이틀 (13pt, Regular) : 금융결제원 차세대 결제 솔루션" Style="{StaticResource HomeSubtitleTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="홈 카드 제목 (15pt, Bold) : 리더기 설정" Style="{StaticResource HomeCardTitleTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="홈 카드 설명 (11pt, Regular) : 리더기 연결 상태를 설정하고 점검합니다." Style="{StaticResource HomeCardDescriptionTextStyle}" Margin="0,6,0,0"/>
                    <!-- 2026-08-20 수정(Phase 13 검증 중 발견): HomeFooterButtonTextStyle은 더 이상 존재하지
                         않음(Typography.xaml이 FontSize 전용 sys:Double 리소스로 분리한 이유는 그 파일
                         상단 주석 참고) — 이 창이 그동안 StartupUri로 실행된 적이 없어 XamlParseException이
                         잠재해 있었다(이번 결제 알림창 검증을 위해 임시로 StartupUri를 바꿔 실행하며 발견). -->
                    <TextBlock Text="홈 하단 버튼 (12pt, Regular) : 최소화 / 종료" FontSize="{StaticResource HomeFooterButtonFontSize}" Foreground="{StaticResource MinimizeExitTextBrush}" Margin="0,6,0,0"/>
                    <Separator Margin="0,10,0,10"/>
                    <TextBlock Text="리더기설정 헤더 타이틀 (18pt, Bold) : 리더기 설정" Style="{StaticResource ReaderHeaderTitleTextStyle}"/>
                    <TextBlock Text="리더기설정 헤더 서브타이틀 (13pt, Bold) : 리더기 연결 및 제어 설정을 관리합니다." Style="{StaticResource ReaderHeaderSubtitleTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="리더기설정 섹션 제목 (15pt, Bold) : 포트 설정" Style="{StaticResource ReaderSectionTitleTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="리더기설정 일반 텍스트 (14pt, Medium) : COM 01" Style="{StaticResource ReaderBodyTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="리더기설정 라벨 (14pt, Bold) : 리더기1 - COM 포트" Style="{StaticResource ReaderLabelTextStyle}" Margin="0,6,0,0"/>
                    <TextBlock Text="리더기설정 작은 텍스트 (12pt, Regular) : 조회된 무결성 체크 정보가 없습니다." Style="{StaticResource ReaderSmallTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== 버튼 ===================== -->
            <TextBlock Text="3. 버튼 (PRD 2.3, CModernButton)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="최소화 (Auto)" Style="{StaticResource AutoButtonStyle}" Width="160" Height="40" Margin="0,0,12,0"/>
                <Button Content="로그 전송 (Default)" Style="{StaticResource DefaultButtonStyle}" Width="160" Height="40" Margin="0,0,12,0"/>
                <Button Content="확인 (Primary)" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="40" Margin="0,0,12,0"/>
                <Button Content="상태체크 (Reader)" Style="{StaticResource ReaderButtonStyle}" Width="160" Height="40"/>
            </StackPanel>
            <TextBlock Text="※ 마우스를 올려 호버 색상, 눌렀을 때 살짝 축소되는 클릭 피드백을 확인하세요." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>

            <!-- ===================== 콤보박스 ===================== -->
            <TextBlock Text="4. 콤보박스 (PRD 2.3, CSkinnedComboBox)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <ComboBox Width="178" Height="36" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="미사용"/>
                <ComboBoxItem Content="COM 01"/>
                <ComboBoxItem Content="COM 02"/>
                <ComboBoxItem Content="COM 03"/>
            </ComboBox>
            <TextBlock Text="※ 두께는 항상 1.5px로 고정, 호버 시 보더만 진한 회색(#9CA3AF)으로, 드롭다운 열림/클릭 시 파란색(#0064DD)+살짝 축소되며 색상만 전환됩니다. 항목 선택 후 드롭다운이 닫히면 즉시 원래 상태로 돌아와야 합니다(더 이상 고정되지 않음)." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>

            <!-- ===================== 토글 스위치 ===================== -->
            <TextBlock Text="5. 토글 스위치 (PRD 2.3, CModernToggleSwitch)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal">
                <ToggleButton Content="포트열기" Style="{StaticResource ModernToggleSwitchStyle}" IsChecked="False" Margin="0,0,32,0"/>
                <ToggleButton Content="멀티패드" Style="{StaticResource ModernToggleSwitchStyle}" IsChecked="True" Margin="0,0,32,0"/>
            </StackPanel>
            <TextBlock Text="※ 클릭 시 노브가 좌우로 슬라이드하며 트랙 색상이 회색↔파란색으로 바뀝니다. 마우스를 올리면 OFF/ON 각각 더 진한 색으로 바뀝니다. OFF 상태에서는 파란색이 남지 않아야 합니다." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>

            <!-- ===================== 텍스트 입력창 ===================== -->
            <TextBlock Text="6. 텍스트 입력창 (PRD 2.3 보강, CSkinnedEdit — 홈/리더기설정 화면에는 없으나 가맹점 설정 화면 대비 선구축)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="COM 01" Width="178" Margin="0,0,16,0"/>
                <TextBox Text="비활성화 상태" Width="178" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Text="※ 콤보박스와 동일한 규칙: 두께는 항상 1.5px로 고정, 마우스를 올리면 보더만 진한 회색, 포커스 시 파란색으로 색상만 전환됩니다(레이아웃 흔들림 없음). 텍스트가 잘리지 않고 온전히 보여야 합니다(기본 높이 44px)." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,24"/>

            <!-- ===================== 결제 알림창(Phase 13, 시각 구현 개발용 트리거) ===================== -->
            <!--
                development_plan.md P13-7: Phase 15(결제 Flow)가 없어 실제 결제 요청으로 알림창을
                띄울 수 없으므로 만든 개발용 임시 트리거다. 최종 산출물이 아니며, Phase 15에서 실제
                Flow가 연결되면 이 버튼/핸들러의 제거 여부를 재검토한다.
            -->
            <TextBlock Text="7. 결제 알림창 (Phase 13, 시각 구현 데모 — 최종 산출물 아님)" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
            <Button x:Name="PaymentNoticeDemoButton" Content="결제 알림창 열기 (IC → FALLBACK → PROCESSING 자동 전환)"
                    Style="{StaticResource PrimaryButtonStyle}" Width="360" Height="40" HorizontalAlignment="Left"
                    Click="PaymentNoticeDemoButton_Click"/>
            <TextBlock Text="※ 클릭하면 알림창이 뜨고 2초 간격으로 IC→FALLBACK→PROCESSING 순서로 자동 전환됩니다. 배경/문구 크로스페이드, 카드 반복 슬라이드 애니메이션을 육안으로 확인하세요." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="IC 상태로 전환" Style="{StaticResource DefaultButtonStyle}" Width="160" Height="36" Margin="0,0,12,0" Click="PaymentNoticeIcButton_Click"/>
                <Button Content="FALLBACK 상태로 전환" Style="{StaticResource DefaultButtonStyle}" Width="160" Height="36" Margin="0,0,12,0" Click="PaymentNoticeFallbackButton_Click"/>
                <Button Content="PROCESSING 상태로 전환" Style="{StaticResource DefaultButtonStyle}" Width="160" Height="36" Click="PaymentNoticeProcessingButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
