<UserControl x:Class="KFTCOneCAP.Wpf.Views.Controls.PaymentProcessingRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="340" Height="226.67"
             d:DesignHeight="226.67" d:DesignWidth="340">
    <!--
        2026-08-24 신설(원판/몸통 자산 분리에 따른 재구성):
        이전에는 리더기 몸통+원판+그림자가 한 장으로 합성된 이미지(reader.png) 위에 이 진행광을
        그릴 수밖에 없어서, 원판의 "몸통에 가려져야 할" 뒤쪽 절반까지 그대로 비쳐 보이는 문제가
        있었다(PaymentProcessingIndicator.xaml의 기존 주석 참고). 이제 원판(circle.png)과 몸통
        (reader_kftc.png)이 분리된 자산으로 제공되어, PaymentNoticeWindow.xaml의 Canvas 순서를
        "원판 → 이 컨트롤(진행광 링) → 몸통" 순으로 쌓기만 하면 링이 몸통 뒤로 지나가는 부분은
        몸통 이미지의 불투명 픽셀에 자동으로 가려진다 — 그래서 이 컨트롤은 반원 클리핑 편법 없이
        "온전한 360도" 타원 경로를 그대로 쓴다.

        타원 파라미터는 circle.png(1536x1024)를 Pillow(alpha 채널 촘촘한 경계 스캔 + 최소자승 피팅)로
        재실측했다(2026-08-24 5차 수정, 사용자 재실측 피드백 — 상세 산출 근거는
        PaymentProcessingRing.xaml.cs 상단 주석 참고): 중심(768.83,610.35) 반경(666.17,346.96) px →
        340x226.67 캔버스로 스케일(340/1536 ≈ 0.221354) 변환 시 중심(170.18,135.10) 반경(147.46,76.80).
        원판 안쪽의 넓은 투명 V자 구간(자산 자체에 뒤쪽이 처음부터 비어 있음)은 피팅에서 제외하고
        좌/우 측면 플랭크와 하단 전 구간만 근거로 삼았다.

        2026-08-24 6차 수정: 펄스 효과(BasePulseGlow)는 사용자 피드백에 따라 완전히 제거했다 — 로고
        펄스(PaymentProcessingIndicator)와 함께 "이상해 보인다"는 지적을 받아 이 링의 베이스 백라이트
        펄스도 함께 걷어냈다. 남은 것은 정적인 베이스 트랙 + 회전 진행광 아크뿐이다.
    -->
    <Canvas IsHitTestVisible="False" Width="340" Height="226.67" ClipToBounds="False">

        <!-- 타원 궤적 베이스 은은한 트랙 (테두리 전체) -->
        <Path Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#3B82F6" StrokeThickness="3" Opacity="0.3"/>

        <!-- 글로우 효과를 입힌 회전 진행광 아크 — 온전한 360도 경로를 시계방향으로 계속 스크롤. -->
        <Path x:Name="OrbitGlowArc"
              Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#60A5FA" StrokeThickness="7"
              StrokeDashArray="169 1000" StrokeDashCap="Round"
              Opacity="0.85">
            <Path.Effect>
                <BlurEffect Radius="8"/>
            </Path.Effect>
        </Path>

        <!-- 선명한 코어 회전 진행광 아크 -->
        <Path x:Name="OrbitCoreArc"
              Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#E0F2FE" StrokeThickness="3.5"
              StrokeDashArray="110 1000" StrokeDashCap="Round"
              Opacity="0.95"/>

        <!-- 진행광 선두(Head) 하이라이트 발광체 점 -->
        <Ellipse x:Name="OrbitHeadLight" Width="14" Height="14"
                 Fill="#FFFFFF" Opacity="0.95"
                 Canvas.Left="0" Canvas.Top="0">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

    </Canvas>
</UserControl>
