<UserControl x:Class="KFTCOneCAP.Wpf.Views.Controls.PaymentProcessingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="340" Height="226.67"
             d:DesignHeight="226.67" d:DesignWidth="340">
    <!--
        거래중 애니메이션 (docs/payment_relay/images/_preview_crop/거래중 애니메이션.png 완벽 구현):
          1. 원형 진행광 (Main): 바닥 원 테두리(타원)의 20~25% 구간을 밝은 파란빛으로 강조하여 시계방향으로 회전
          2. 슬롯 내부 빛 흐름 (Sub): IC 슬롯 안쪽에서 하늘색 하이라이트가 좌 -> 우로 부드럽게 이동
          3. 은은한 펄스 (Sub): 전면 로고 및 하단 베이스가 은은하게 밝아졌다 어두워짐
    -->
    <Canvas IsHitTestVisible="False" Width="340" Height="226.67" ClipToBounds="False">

        <!-- ===== 3. 하단 베이스 은은한 백라이트 펄스 ===== -->
        <Path x:Name="BasePulseGlow"
              Data="M 22,137 A 148,40 0 1 0 318,137 A 148,40 0 1 0 22,137"
              Stroke="#3B82F6" StrokeThickness="6" Opacity="0.15">
            <Path.Effect>
                <BlurEffect Radius="12"/>
            </Path.Effect>
        </Path>

        <!-- ===== 1. 원형 진행광 (Main) ===== -->
        <!-- 타원 궤적 베이스 은은한 트랙 (전면 반원 림) -->
        <Path Data="M 22,137 A 148,40 0 0 0 318,137"
              Stroke="#3B82F6" StrokeThickness="3.5" Opacity="0.35"/>

        <!-- 글로우 효과를 입힌 회전 진행광 아크 (전면 트랙을 따라 자연스러운 회전광 연출)
             2026-08-24 수정: 이전엔 타원 전체(360도, M...A...A로 만든 닫힌 경로)를 따라 돌리고
             RectangleGeometry로 아래쪽만 클립했는데, 사각형 클립이 타원의 곡선 경계와 맞지 않아
             빛이 원판(타원) 밖으로 삐져나오거나 몸통 위에 그대로 비치는 문제가 있었다. 그래서 경로
             자체를 처음부터 "보이는 앞쪽 반원"(위의 기본 트랙과 동일한 Data)만으로 한정해 클립 없이도
             항상 타원 테두리 위에만 있도록 정정했다 — 열린 반원 경로라 계속 같은 방향으로 돌 수 없으므로
             (한쪽 끝에 닿으면 튀어야 함) 왕복(AutoReverse)으로 바꿨다(코드비하인드 Play() 참고). -->
        <Path x:Name="OrbitGlowArc"
              Data="M 22,137 A 148,40 0 0 0 318,137"
              Stroke="#60A5FA" StrokeThickness="7"
              StrokeDashArray="80 1000" StrokeDashCap="Round"
              Opacity="0.85">
            <Path.Effect>
                <BlurEffect Radius="8"/>
            </Path.Effect>
        </Path>

        <!-- 선명한 코어 회전 진행광 아크 (위와 같은 이유로 반원 경로로 정정) -->
        <Path x:Name="OrbitCoreArc"
              Data="M 22,137 A 148,40 0 0 0 318,137"
              Stroke="#E0F2FE" StrokeThickness="3.5"
              StrokeDashArray="55 1000" StrokeDashCap="Round"
              Opacity="0.95"/>

        <!-- 진행광 선두(Head) 하이라이트 발광체 점 -->
        <Ellipse x:Name="OrbitHeadLight" Width="14" Height="14"
                 Fill="#FFFFFF" Opacity="0.95"
                 Canvas.Left="0" Canvas.Top="0">
            <Ellipse.Clip>
                <RectangleGeometry Rect="-20,0,50,50"/>
            </Ellipse.Clip>
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 2. 슬롯 내부 빛 흐름 ===== -->
        <!-- 슬롯 이동 영역 (X:120,Y:60 -> X:200,Y:98 대각선) -->
        <Ellipse x:Name="SlotFlow" Width="40" Height="14" Canvas.Left="120" Canvas.Top="60"
                 Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="26"/>
                    <TranslateTransform x:Name="SlotFlowTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#8038BDF8" Offset="0.5"/>
                    <GradientStop Color="#0038BDF8" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 3. 은은한 펄스 (로고 영역) ===== -->
        <Ellipse x:Name="LogoPulseGlow" Width="30" Height="30" Canvas.Left="130" Canvas.Top="105"
                 Fill="#38BDF8" Opacity="0.2">
            <Ellipse.Effect>
                <BlurEffect Radius="10"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 로고 중심 코어 스파크 -->
        <Ellipse x:Name="LogoCoreGlow" Width="12" Height="12" Canvas.Left="139" Canvas.Top="114"
                 Fill="#FFFFFF" Opacity="0.4">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

    </Canvas>
</UserControl>
