<UserControl x:Class="KFTCOneCAP.Wpf.Views.Controls.PaymentProcessingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="340" Height="226.67"
             d:DesignHeight="226.67" d:DesignWidth="340">
    <!--
        2026-08-21 추가 — 사용자가 제시한 "거래중 애니메이션" 기획(원형 진행광 회전 + 슬롯 내부 빛
        흐름 + 은은한 펄스, docs/payment_relay/images/_preview_crop/거래중 애니메이션.png)을 그대로
        구현한다. 문구 없이도 "처리 중"임을 인지할 수 있게 하고, reader.png는 그대로 두고 그 위에
        오버레이로만 표현한다(기획서 "추천 포인트" 원칙). 새 이미지 자산은 쓰지 않는다(전부 벡터).

        이 컨트롤은 PaymentNoticeWindow의 ReaderImage와 정확히 같은 위치/크기(Canvas.Left=205,
        Top=245, 340x226.67)에 겹쳐 놓는 것을 전제로, 실제 화면 스크린샷을 확대해 다시 측정한 로컬
        좌표(이 340x226.67 박스 기준)를 쓴다(최초 reader.png 픽셀 스캔 추정치는 실측과 어긋나 폐기):
          - 바닥 타원: 중심(170,135), rx=135, ry=45 — "보이는 절반"은 각도 0~180도(y-down 기준
            0=오른쪽,90=아래,180=왼쪽), 위쪽 절반(180~360)은 몸통 뒤에 가려져야 하는 영역이다.
          - IC 슬롯/로고 영역: local (145,108) 근방(펄스 효과, PulseGlow)
        정밀한 슬롯 곡선 추적이 아니라 육안으로 자연스러운 위치를 스크린샷으로 조정한 값이다.
    -->
    <Canvas IsHitTestVisible="False">

        <!-- ===== 1. 원형 진행광(Main) — 바닥 타원의 보이는 앞쪽 크레센트를 따라 점 6개를 배치하고
             순차 발광(체이스)시켜 "돌아가는" 느낌을 낸다 =====
             2026-08-21 좌표 정정 2차·3차: ①리지드 RotateTransform으로 타원(rx≠ry) 호를 돌리면 호가
             테두리를 벗어나는 결함, ②Path/ArcSegment(Size+두 점으로 호를 역산하는 방식)이 예상과
             다른 훨씬 큰 호를 그리는 결함을 실제 화면에서 각각 확인했다. 두 방식 모두 재현이
             까다로워, **좌표 계산을 신뢰할 수 있는 EllipsePoint(코드비하인드) 결과를 점 6개의 고정
             위치로만 쓰고, Path/ArcSegment 없이 Opacity 체이스로만 회전감을 표현**하는 훨씬 단순하고
             예측 가능한 방식으로 바꿨다. 좌표(cx=170,cy=135,rx=135,ry=45, 각도 25~140도 6등분,
             EllipsePoint(angle) 계산값)는 코드비하인드가 Loaded 시 1회 배치한다(x:Name만 부여). -->
        <Ellipse x:Name="RingDot1" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="RingDot2" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="RingDot3" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="RingDot4" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="RingDot5" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="RingDot6" Width="12" Height="12" Fill="{StaticResource Blue500Brush}" Opacity="0.2">
            <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
        </Ellipse>

        <!-- ===== 2. 슬롯 내부 빛 흐름(Sub) — 하늘색 하이라이트가 좌→우로 부드럽게 이동 =====
             2026-08-21 좌표 정정: 슬롯 홈 대각선(확대 스크린샷 실측) 시작점으로 이동.
             2026-08-21 크기/밝기 보강: reader.png 자체의 슬롯 홈에 이미 밝은 파란 테두리가 있어
             처음 크기(34x12, 흐린 하늘색)로는 원래 있던 선과 구분이 안 될 만큼 묻혔다(실제 화면
             확인). 흰색에 가까운 밝은 색 + 더 큰 사이즈로 보강했다.
             2026-08-21 위치 정정: 확대 스크린샷으로 다시 보니 홈선보다 왼쪽 바깥에 떠 있었다.
             홈선 시작 지점(local 128,63 부근)에 맞춰 이동. -->
        <Ellipse x:Name="SlotFlow" Width="46" Height="18" Canvas.Left="105" Canvas.Top="54"
                 Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="SlotFlowTranslate" X="0" Y="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- ===== 3. 은은한 펄스(Sub) — 로고 영역이 아주 약하게 밝아졌다 어두워짐 ===== -->
        <Ellipse x:Name="PulseGlow" Width="26" Height="26" Canvas.Left="132" Canvas.Top="95"
                 Fill="{StaticResource Blue500Brush}" Opacity="0.18">
            <Ellipse.Effect>
                <BlurEffect Radius="8"/>
            </Ellipse.Effect>
        </Ellipse>

    </Canvas>
</UserControl>
