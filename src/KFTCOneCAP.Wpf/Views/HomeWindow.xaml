<Window x:Class="KFTCOneCAP.Wpf.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KFTCOneCAP Plus Ver 3.0.9 | 모듈 Ver 524"
        Width="{StaticResource HomeWindowWidth}"
        Height="{StaticResource HomeWindowHeight}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HomeBgBrush}"
        Loaded="HomeWindow_Loaded"
        Closing="HomeWindow_Closing">
    <!--
        홈 화면 — 정적 레이아웃 (Phase 2, docs/home_reader_setup/ROADMAP.md).
        치수는 전부 Themes/Layout.xaml 리소스 키를 참조한다(리터럴 금지 — Phase 6 컴팩트 모드
        리소스 스왑 대비, docs/home_reader_setup/ROADMAP.md Phase 2 안내 참고).
        카드 호버/눌림 애니메이션, 카드 클릭 동작, 트레이 아이콘은 Phase 3에서 배선한다.

        타이틀바 텍스트 "KFTCOneCAP Plus Ver 3.0.9 | 모듈 Ver 524" 는
        docs/home_reader_setup/screenshots/home_screen.png 실측 캡처를 그대로 사용한 것으로, 버전 조합 규칙(빌드마다
        동적으로 어떻게 조합되는지)은 PRD_WPF.md 3.2 / 6장 #7 기준 여전히 미확정이다.
        TODO(PRD 미확정 #7): 실제 앱 버전/모듈 버전을 어디서 읽어와 조합하는지 확인되면
        하드코딩된 문자열을 동적 바인딩으로 교체할 것.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 헤더 -->
            <RowDefinition Height="{StaticResource HomeHeaderCardGapGridLength}"/>
            <!-- 헤더-카드 사이 유연 간격 -->
            <RowDefinition Height="{StaticResource HomeCardVisualHGridLength}"/>
            <!-- 카드 4개 -->
            <RowDefinition Height="{StaticResource HomeCardDividerGapGridLength}"/>
            <!-- 카드-구분선 사이 유연 간격 -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 구분선 -->
            <RowDefinition Height="Auto"/>
            <!-- 최소화/종료 버튼 -->
        </Grid.RowDefinitions>

        <!-- ===================== 헤더 ===================== -->
        <Grid Grid.Row="0" Margin="{StaticResource HomeHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 로고 + 타이틀/Plus뱃지 + 서브타이틀 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                <!--
                    로고: 원본은 실행 파일 옆 img_ci_mark.png 를 로드해 그린다(KFTCOneCAPDlg.cpp
                    GetLogoPath/LoadLogoImage). 2026-08-13: 사용자가 실제 자산(img_ci_mark.png)을
                    Assets/Images/ 에 제공해 Image 컨트롤로 교체(이전 Path 벡터 근사 제거).
                    크기는 docs/home_reader_setup/screenshots/home_screen.png 실측(로고 원 영역 약 54x54px)과
                    일치하는 기존 HomeLogoBoxSize 리소스를 그대로 사용.
                -->
                <Image Source="/Assets/Images/img_ci_mark.png"
                       Width="{StaticResource HomeLogoBoxSize}" Height="{StaticResource HomeLogoBoxSize}"
                       Stretch="Uniform" VerticalAlignment="Top"/>

                <StackPanel Margin="15,0,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KFTCOneCAP" Style="{StaticResource HomeTitleTextStyle}" VerticalAlignment="Center"/>
                        <Border Background="#1F72D6" CornerRadius="6" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="Plus" Foreground="White" FontFamily="{StaticResource PretendardFontFamily}" FontSize="13" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="금융결제원 결제 솔루션 프로그램 Plus Ver 3.0.9 | 모듈 Ver 524"
                               Style="{StaticResource HomeSubtitleTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>

            <!--
                우측: 로그 전송 / 최신 버전 업데이트.
                2026-08-13 수정(사용자 피드백): 원본(ModernUI.cpp CModernButton::DrawItem,
                isLogTransfer/isUpdate 분기)은 이 두 버튼에 테두리/배경을 그리지 않는다
                (호버 시에만 옅은 배경이 나타나는 "고스트" 스타일). 아이콘 색은 호버 여부와 무관하게
                항상 고정색(로그전송=파랑 #3182F6, 업데이트=초록 #22C55E)이고, 텍스트만 기본 검정에서
                호버 시 같은 색으로 바뀐다. 이를 위해 Content를 아이콘/텍스트 TextBlock 2개로 분리
                (아이콘은 Foreground를 직접 지정해 항상 고정, 텍스트는 지정하지 않아 Button.Foreground
                상속 — Buttons.xaml DefaultButtonStyle/UpdateButtonStyle의 호버 트리거로 색이 바뀜).
            -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Style="{StaticResource DefaultButtonStyle}"
                        Width="{StaticResource HomeHeaderLogSendBtnW}"
                        Height="{StaticResource HomeHeaderLogSendBtnH}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2193;" FontSize="{StaticResource HomeFooterButtonFontSize}" FontWeight="Bold"
                                   Foreground="{StaticResource LogSendHoverTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="로그 전송" FontSize="{StaticResource HomeFooterButtonFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource UpdateButtonStyle}"
                        Width="{StaticResource HomeHeaderUpdateBtnW}"
                        Height="{StaticResource HomeHeaderUpdateBtnH}"
                        Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB;" FontSize="{StaticResource HomeFooterButtonFontSize}" FontWeight="Bold"
                                   Foreground="{StaticResource UpdateHoverTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="최신 버전 업데이트" FontSize="{StaticResource HomeFooterButtonFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== 카드 4개 ===================== -->
        <Grid Grid.Row="2" Margin="{StaticResource HomeCardsAreaMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource HomeCardGapGridLength}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource HomeCardGapGridLength}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource HomeCardGapGridLength}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 카드 1: 리더기 설정 -->
            <Button Grid.Column="0" Style="{StaticResource HomeCardButtonStyle}" x:Name="ReaderSetupCardButton"
                    Command="{Binding OpenReaderSetupCommand}">
                <Grid Margin="{StaticResource HomeCardContentMargin}">
                    <!--
                        2026-08-13 수정(사용자 피드백): 아이콘-제목 사이 행을 "*"(가변)에서 고정
                        간격(HomeCardIconTitleGapGridLength=24)으로 교체. 카드 높이가 고정(260)인
                        상태에서 "*" 행이 남는 공간을 전부 흡수해 제목/설명이 카드 하단으로 밀려
                        내려가던 문제 수정(Layout.xaml 리소스 주석 참고). Grid의 나머지 행이 모두
                        Auto/고정값이므로 콘텐츠가 상단부터 채워지고 남는 여백은 카드 하단에 남는다
                        (원본 실측과 일치).
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource HomeCardIconTitleGapGridLength}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="{StaticResource HomeCardIconBoxSize}" Height="{StaticResource HomeCardIconBoxSize}"
                            Style="{StaticResource HomeCardIconBoxStyle}" CornerRadius="{StaticResource HomeCardIconCornerRadius}"
                            HorizontalAlignment="Left">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="28" Height="28">
                                <!--
                                    2026-08-14 재설계(사용자 피드백: "아이콘이 부자연스럽다, 더 이쁘고
                                    자연스럽게"): 기존 지오메트리는 화면/키패드 6개가 각각 다른
                                    간격·크기로 비대칭이고, 하단의 얇은 슬롯 선(rect 8,23,11,0.9)이
                                    독립된 잔여물처럼 붕 떠 보였다. 본체(EvenOdd cutout) 하나에 화면/
                                    키패드 6개/하단 슬롯을 전부 "구멍"으로 통일해 모든 요소가 같은
                                    시각적 두께로 보이도록 하고, 좌우 대칭·행간/열간 간격을 동일하게
                                    맞춰 재설계했다(카드 아이콘, 리더기 설정 헤더 아이콘 공용).
                                -->
                                <Path Style="{StaticResource HomeCardIconGlyphStyle}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="4.5,2.25,19,23.5" RadiusX="3" RadiusY="3"/>
                                            <RectangleGeometry Rect="7.5,5.25,13,8" RadiusX="1.5" RadiusY="1.5"/>
                                            <RectangleGeometry Rect="7.5,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="12.3,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="17.1,15,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="7.5,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="12.3,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="17.1,18.8,3.4,2.6" RadiusX="0.7" RadiusY="0.7"/>
                                            <RectangleGeometry Rect="8.5,23,11,1.2" RadiusX="0.6" RadiusY="0.6"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Left">
                        <TextBlock Text="리더기 설정" Style="{StaticResource HomeCardTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="리더기 연결 상태를&#x0a;설정하고 점검합니다." Style="{StaticResource HomeCardDescriptionTextStyle}" Margin="0,8,0,0"/>
                </Grid>
            </Button>

            <!-- 카드 2: 가맹점 설정 -->
            <Button Grid.Column="2" Style="{StaticResource HomeCardButtonStyle}" x:Name="ShopSetupCardButton"
                    Command="{Binding OpenShopSetupCommand}">
                <Grid Margin="{StaticResource HomeCardContentMargin}">
                    <!--
                        2026-08-13 수정(사용자 피드백): 아이콘-제목 사이 행을 "*"(가변)에서 고정
                        간격(HomeCardIconTitleGapGridLength=24)으로 교체. 카드 높이가 고정(260)인
                        상태에서 "*" 행이 남는 공간을 전부 흡수해 제목/설명이 카드 하단으로 밀려
                        내려가던 문제 수정(Layout.xaml 리소스 주석 참고). Grid의 나머지 행이 모두
                        Auto/고정값이므로 콘텐츠가 상단부터 채워지고 남는 여백은 카드 하단에 남는다
                        (원본 실측과 일치).
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource HomeCardIconTitleGapGridLength}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="{StaticResource HomeCardIconBoxSize}" Height="{StaticResource HomeCardIconBoxSize}"
                            Style="{StaticResource HomeCardIconBoxStyle}" CornerRadius="{StaticResource HomeCardIconCornerRadius}"
                            HorizontalAlignment="Left">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="28" Height="28">
                                <Path Style="{StaticResource HomeCardIconGlyphStyle}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <PathGeometry Figures="M14,3 L26,11 L2,11 Z"/>
                                            <RectangleGeometry Rect="3.5,11,21,15"/>
                                            <RectangleGeometry Rect="10.5,17.5,6,8.5"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Left">
                        <TextBlock Text="가맹점 설정" Style="{StaticResource HomeCardTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="가맹점 정보와 결제 환경을&#x0a;설정합니다." Style="{StaticResource HomeCardDescriptionTextStyle}" Margin="0,8,0,0"/>
                </Grid>
            </Button>

            <!-- 카드 3: 결제 -->
            <Button Grid.Column="4" Style="{StaticResource HomeCardButtonStyle}" x:Name="TransCardButton"
                    Command="{Binding OpenTransCommand}">
                <Grid Margin="{StaticResource HomeCardContentMargin}">
                    <!--
                        2026-08-13 수정(사용자 피드백): 아이콘-제목 사이 행을 "*"(가변)에서 고정
                        간격(HomeCardIconTitleGapGridLength=24)으로 교체. 카드 높이가 고정(260)인
                        상태에서 "*" 행이 남는 공간을 전부 흡수해 제목/설명이 카드 하단으로 밀려
                        내려가던 문제 수정(Layout.xaml 리소스 주석 참고). Grid의 나머지 행이 모두
                        Auto/고정값이므로 콘텐츠가 상단부터 채워지고 남는 여백은 카드 하단에 남는다
                        (원본 실측과 일치).
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource HomeCardIconTitleGapGridLength}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="{StaticResource HomeCardIconBoxSize}" Height="{StaticResource HomeCardIconBoxSize}"
                            Style="{StaticResource HomeCardIconBoxStyle}" CornerRadius="{StaticResource HomeCardIconCornerRadius}"
                            HorizontalAlignment="Left">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="28" Height="28">
                                <Path Style="{StaticResource HomeCardIconGlyphStyle}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <RectangleGeometry Rect="1,4.5,26,19" RadiusX="2.5" RadiusY="2.5"/>
                                            <RectangleGeometry Rect="1,9,26,3"/>
                                            <RectangleGeometry Rect="7,14,9,6" RadiusX="1" RadiusY="1"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <Path Style="{StaticResource HomeCardIconGlyphStyle}">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="8,15,2,1.8"/>
                                            <RectangleGeometry Rect="11,15,2,1.8"/>
                                            <RectangleGeometry Rect="14,15,2,1.8"/>
                                            <RectangleGeometry Rect="8,17.8,2,1.8"/>
                                            <RectangleGeometry Rect="11,17.8,2,1.8"/>
                                            <RectangleGeometry Rect="14,17.8,2,1.8"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Left">
                        <TextBlock Text="결제" Style="{StaticResource HomeCardTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="결제 화면을 실행하고&#x0a;결제을 진행합니다." Style="{StaticResource HomeCardDescriptionTextStyle}" Margin="0,8,0,0"/>
                </Grid>
            </Button>

            <!-- 카드 4: 전표 설정 -->
            <Button Grid.Column="6" Style="{StaticResource HomeCardButtonStyle}" x:Name="ReceiptSetupCardButton"
                    Command="{Binding OpenReceiptSetupCommand}">
                <Grid Margin="{StaticResource HomeCardContentMargin}">
                    <!--
                        2026-08-13 수정(사용자 피드백): 아이콘-제목 사이 행을 "*"(가변)에서 고정
                        간격(HomeCardIconTitleGapGridLength=24)으로 교체. 카드 높이가 고정(260)인
                        상태에서 "*" 행이 남는 공간을 전부 흡수해 제목/설명이 카드 하단으로 밀려
                        내려가던 문제 수정(Layout.xaml 리소스 주석 참고). Grid의 나머지 행이 모두
                        Auto/고정값이므로 콘텐츠가 상단부터 채워지고 남는 여백은 카드 하단에 남는다
                        (원본 실측과 일치).
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource HomeCardIconTitleGapGridLength}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="{StaticResource HomeCardIconBoxSize}" Height="{StaticResource HomeCardIconBoxSize}"
                            Style="{StaticResource HomeCardIconBoxStyle}" CornerRadius="{StaticResource HomeCardIconCornerRadius}"
                            HorizontalAlignment="Left">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="28" Height="28">
                                <Path Style="{StaticResource HomeCardIconGlyphStyle}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <PathGeometry Figures="M6,3 L22,3 L22,20 L20,24 L18,20 L16,24 L14,20 L12,24 L10,20 L8,24 L6,20 Z"/>
                                            <RectangleGeometry Rect="9,7,12,1.4"/>
                                            <RectangleGeometry Rect="9,10,10,1.4"/>
                                            <RectangleGeometry Rect="9,13,8,1.4"/>
                                            <RectangleGeometry Rect="9,16,6,1.4"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Left">
                        <TextBlock Text="전표 설정" Style="{StaticResource HomeCardTitleTextStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="프린터 포트와 출력 옵션을&#x0a;설정합니다." Style="{StaticResource HomeCardDescriptionTextStyle}" Margin="0,8,0,0"/>
                </Grid>
            </Button>
        </Grid>

        <!-- ===================== 하단 구분선 ===================== -->
        <Border Grid.Row="4" Height="1" Background="{StaticResource FooterDividerBrush}"
                Margin="{StaticResource HomeDividerMargin}"/>

        <!--
            ===================== 최소화 / 종료 =====================
            2026-08-13 수정(사용자 피드백): 원본은 이 두 버튼도 테두리/배경이 없는 고스트 스타일이며
            아이콘/텍스트가 같은 회색(#8B95A1)으로 함께 호버 시 진한 회색(#333D4B)으로 바뀐다
            (ModernUI.cpp CModernButton::DrawItem, isExit 분기 — m_clrNormalBg=kHomeBg로 평상시
            테두리가 배경색과 같아 사실상 보이지 않음). Buttons.xaml AutoButtonStyle에서
            BorderThickness=0으로 교체.
        -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource HomeFooterAreaMargin}">
            <Button x:Name="MinimizeButton" Style="{StaticResource AutoButtonStyle}"
                    Width="{StaticResource HomeFooterBtnW}" Height="{StaticResource HomeFooterBtnH}"
                    FontSize="{StaticResource HomeFooterButtonFontSize}" Click="MinimizeButton_Click">
                <TextBlock Text="&#x2212; 최소화" FontFamily="{StaticResource PretendardFontFamily}"/>
            </Button>
            <Button x:Name="ExitButton" Style="{StaticResource AutoButtonStyle}"
                    Width="{StaticResource HomeFooterBtnW}" Height="{StaticResource HomeFooterBtnH}"
                    FontSize="{StaticResource HomeFooterButtonFontSize}" Margin="{StaticResource HomeFooterBtnMargin}" Click="ExitButton_Click">
                <TextBlock Text="&#x23FB; 프로그램 종료" FontFamily="{StaticResource PretendardFontFamily}"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
