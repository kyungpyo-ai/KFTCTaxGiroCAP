<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!--
      Phase 8(docs/payment_relay/ROADMAP.md): 결제 중계 기능이 연동하는 두 네이티브 DLL
      (vendor/ReaderSerial/ReaderSerial.dll, vendor/KftcGiro/KFTC_GIRO.dll)이 모두 32bit(x86)
      전용이라, 프로세스도 반드시 32bit여야 DllImport 호출 시 BadImageFormatException이 나지
      않는다. AnyCPU로 되돌리면(64bit OS에서 64bit 프로세스로 기동) 두 DLL을 전혀 로드할 수 없다
      — PRD.md §2.3 근거, 절대 제거하지 말 것.
    -->
    <PlatformTarget>x86</PlatformTarget>
    <!--
      Phase 3(ROADMAP.md): 트레이 아이콘 구현에 System.Windows.Forms.NotifyIcon 을 사용하기 위해
      WinForms interop 활성화. WPF에는 네이티브 트레이 API가 없어 PRD 3.6이 명시적으로 이 방식을
      지정함. net48이므로 Windows 7까지 문제없이 동작(CLAUDE.md 제약과 무관 — .NET Framework
      전용 WinForms 상호운용이며 Win10+ 전용 API 아님).
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Phase 22(docs/operations/development_plan.md P22-0, PRD.md §1.1.1, 2026-09-01 확정): 로그 경로가
      C:\KFTC_PosAgent\KFTCTaxLog\ (일반 권한으로는 쓰기가 안 될 수 있는 C:\ 루트 하위)로 바뀌면서,
      앱을 항상 관리자 권한으로 실행해야 한다. app.manifest의 requireAdministrator가 이를 강제한다.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      Phase 11(docs/payment_relay/development_plan.md P11-1): 무결성 체크 이력 저장(PRD §7)에 쓸
      SQLite 클라이언트. Microsoft.Data.Sqlite를 우선 시도해 x86/net48에서 "열고 쿼리 한 번"까지
      실제로 성공함을 확인했다(네이티브 e_sqlite3.dll이 출력 폴더 루트에 자동 복사되고, PE 헤더가
      IMAGE_FILE_MACHINE_I386(x86)임을 실측 확인) — System.Data.SQLite.Core로 전환할 필요가
      없었다. 버전 10.0.11은 nupkg가 net48을 명시적으로 지원하는 최신 버전(패키지 메타데이터가
      .NET 10 트랙 번호를 쓸 뿐, TFM 자체는 net48을 포함한다).
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Assets\Fonts\Pretendard-Medium.ttf" />
    <Resource Include="Assets\Fonts\Pretendard-Bold.ttf" />
    <Resource Include="Assets\Images\img_ci_mark.png" />
    <!--
      Phase 13(docs/payment_relay/development_plan.md P13-1, 2026-08-21 자산 구조 재구성): 결제
      알림창 자산. 리더기 몸통은 IC/FALLBACK/PROCESSING 3개 상태 공용 정지 이미지 1장(reader.png,
      흰색/파란 글로시 스타일), 화살표는 상태별 독립 레이어(arrow_ic.png/arrow_ms.png)로 분리했다.
      카드도 사용자가 직접 제공한 아이소메트릭 카드 이미지(ic_card.png/ms_card.png)로 교체했다 —
      벡터로 각도를 직접 재현하려던 시도(Views/Controls/PaymentCardShape.xaml)가 두 차례 실패해
      (리더기 슬롯 각도 그대로 큰 회전 → 다이아몬드처럼 보임, 세워진 카드+두께 옆면으로 정정해도
      원본과 미세하게 다름) 실제 카드 이미지로 대체했다(2026-08-21). 이전의 카드까지 합성된 배경
      (BG_IMG_IC/MS/PROCESSING.png)은 더 이상 쓰지 않는다. LOCK/QR은 배치하지 않는다(범위 밖).
    -->
    <Resource Include="Assets\Images\PaymentNotice\reader.png" />
    <Resource Include="Assets\Images\PaymentNotice\reader_kftc.png" />
    <Resource Include="Assets\Images\PaymentNotice\circle.png" />
    <Resource Include="Assets\Images\PaymentNotice\arrow_ic.png" />
    <Resource Include="Assets\Images\PaymentNotice\arrow_ms.png" />
    <Resource Include="Assets\Images\PaymentNotice\ic_card.png" />
    <Resource Include="Assets\Images\PaymentNotice\ms_card.png" />
    <!-- Phase 18(P18-2): PIN 입력 화면 아이콘(카드+자물쇠, 배경 투명). -->
    <Resource Include="Assets\Images\PaymentNotice\비밀번호 입력 아이콘.png" />
  </ItemGroup>

  <!--
    Phase 8(docs/payment_relay/development_plan.md P8-2): 두 네이티브 DLL은 프로젝트 참조가 아니라
    런타임에 DllImport로 로드되는 고정 바이너리이므로(빌드 산출물이 아님), 조건부 Copy Target 대신
    단순한 None + CopyToOutputDirectory로 배선한다. <Link>로 출력 폴더 루트에 평평하게 놓는다 —
    DllImport의 기본 탐색 경로는 실행 파일이 있는 폴더다.
  -->
  <ItemGroup>
    <None Include="..\..\vendor\ReaderSerial\ReaderSerial.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ReaderSerial.dll</Link>
    </None>
    <None Include="..\..\vendor\KftcGiro\KFTC_GIRO.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>KFTC_GIRO.dll</Link>
    </None>
  </ItemGroup>

</Project>
